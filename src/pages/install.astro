---
import "../styles/base.css";
import "../styles/install.css";
import InstallPage from "../components/Install.astro";
import Layout from "../layouts/Layout.astro";

const title = "Install Aelum — four screens, then it installs.";
const description =
  "The Aelum installer asks four questions — language, user, disk, confirm — then installs a full Arch system entirely from the live ISO in about a minute and a half.";
---

<Layout title={title} description={description} active="install">
  <InstallPage />
</Layout>
