---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Desktop from "../components/Desktop.astro";
import Install from "../components/Install.astro";
import Languages from "../components/Languages.astro";
import CLI from "../components/CLI.astro";
import Footer from "../components/Footer.astro";
import { isoRepo } from "../lib/site";

const title = "AestheticOS — Beautiful, fully offline Arch Linux";
const description =
  "AestheticOS — a beautiful, fully offline Arch Linux distro. Boot it, run the installer, and get a polished Hyprland desktop. No internet, ever.";

// Structured data so search engines understand the project.
// Rendered inline as a JSON-LD literal so it is present in the static HTML
// (server-side), which is what search engines expect. Note: `sameAs` is
// reserved for identity pages (social profiles, etc.), not source repos.
// The ISO and installer repos are already linked in the visible page
// (Hero + CTA/Footer), so they remain discoverable.
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AestheticOS",
        "operatingSystem": "Arch Linux",
        "description": "AestheticOS — a beautiful, fully offline Arch Linux distro. Boot it, run the installer, and get a polished Hyprland desktop. No internet, ever.",
        "applicationCategory": "System Tool",
        "url": "https://kornienkodev.github.io/AestheticOS-Web/"
      }
    </script>
  </Fragment>

  <a class="skip-link" href="#top">Skip to main content</a>
  <div class="bg-field" aria-hidden="true"></div>

  <Nav />

  <main id="top">
    <Hero>
      <slot name="actions" slot="actions">
        <a
          class="btn btn-primary"
          href={isoRepo}
          target="_blank"
          rel="noopener"
        >
          <span class="nf-icon" aria-hidden="true" style="font-size:1.6rem">
            {String.fromCodePoint(0xf0ed)}
          </span> Get the ISO
        </a>
        <a class="btn btn-ghost" href="#install">Watch it install</a>
      </slot>
    </Hero>

    <Features />
    <Desktop />
    <Install />
    <Languages />
    <CLI />
  </main>

  <Footer />
</Layout>
