---
import "../styles/base.css";
import "../styles/home.css";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";

const title = "Aelum — an Arch Linux distro with an offline installer";
const description =
  "Aelum — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.";
---

<Layout title={title} description={description} active="home">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Aelum",
        "operatingSystem": "Arch Linux",
        "description": "Aelum — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.",
        "applicationCategory": "System Tool",
        "url": "https://aelum.dev/"
      }
    </script>
  </Fragment>

  <Hero>
    <Fragment slot="actions">
      <a class="btn btn-primary btn-lg" href="/download/">
        <span class="nf-icon" aria-hidden="true">
          {String.fromCodePoint(0xf0ed)}
        </span>
        Download
      </a>
      <a class="btn btn-ghost btn-lg" href="/install/">Watch it install</a>
    </Fragment>
  </Hero>
</Layout>
