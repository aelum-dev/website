---
import "../styles/base.css";
import "../styles/home.css";
import Flow from "../components/Flow.astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { siteOrigin } from "../lib/site";

const title = "Aelum — an Arch Linux distro with an offline installer";
const description =
  "Aelum — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + Dux Shell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.";
// The same application the pages describe, in the vocabulary search engines
// read. Built from siteOrigin so the URL is the configured one, never a copy.
const appJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Aelum",
  operatingSystem: "Arch Linux",
  description,
  applicationCategory: "System Tool",
  url: siteOrigin,
});
---

<Layout title={title} description={description} active="home" showCta={false}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={appJsonLd}></script>
  </Fragment>

  <Hero>
    <Fragment slot="actions">
      <a class="btn btn-primary btn-lg" href="/download/">
        <span class="nf-icon" aria-hidden="true">
          {String.fromCodePoint(0xf0ed)}
        </span>
        Download
      </a>
      <a class="btn btn-ghost btn-lg" href="/install/">Watch it install</a>
    </Fragment>
  </Hero>

  <Flow />
</Layout>
