---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Desktop from "../components/Desktop.astro";
import Features from "../components/Features.astro";
import Install from "../components/Install.astro";
import Languages from "../components/Languages.astro";
import CLI from "../components/CLI.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import { mainRepo } from "../lib/site";

const title = "AestheticOS — an Arch Linux distro with an offline installer";
const description =
  "AestheticOS — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.";

// Structured data so search engines understand the project.
// Rendered inline as a JSON-LD literal so it is present in the static HTML
// (server-side), which is what search engines expect. Note: `sameAs` is
// reserved for identity pages (social profiles, etc.), not source repos.
// The ISO and installer repos are already linked in the visible page
// (Hero + CTA/Footer), so they remain discoverable.
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AestheticOS",
        "operatingSystem": "Arch Linux",
        "description": "AestheticOS — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.",
        "applicationCategory": "System Tool",
        "url": "https://aestheticos.gitlab.io/website/"
      }
    </script>
  </Fragment>

  <a class="skip-link" href="#top">Skip to main content</a>
  <div class="bg-field" aria-hidden="true">
    <span class="orb"></span>
  </div>

  <Nav />

  <main id="top">
    <Hero>
      <slot name="actions" slot="actions">
        <a
          class="btn btn-primary"
          href={mainRepo}
          target="_blank"
          rel="noopener"
        >
          <span class="nf-icon" aria-hidden="true" style="font-size:1.6rem">
            {String.fromCodePoint(0xf0ed)}
          </span>Download
        </a>
        <a class="btn btn-ghost" href="#install">Watch it install</a>
      </slot>
    </Hero>

    <Desktop />
    <Install />
    <Features />
    <Languages />
    <CLI />
    <CTA />
  </main>

  <Footer />
</Layout>
