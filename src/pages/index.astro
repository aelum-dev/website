---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Desktop from '../components/Desktop.astro';
import Install from '../components/Install.astro';
import Languages from '../components/Languages.astro';
import CLI from '../components/CLI.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import Star from '../components/Star.astro';
import { isoRepo, ghRepo } from '../lib/site';

const title = 'AestheticOS — Beautiful, fully offline Arch Linux';
const description =
  'AestheticOS — a beautiful, fully offline Arch Linux distro. Boot it, run the installer, and get a polished Hyprland desktop. No internet, ever.';

// Structured data so search engines understand the project.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AestheticOS',
  operatingSystem: 'Arch Linux',
  description,
  url: Astro.url.href,
  applicationCategory: 'System Tool',
  sameAs: [isoRepo, ghRepo],
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify(jsonLd)}</script>
  </Fragment>

  <a class="skip-link" href="#top">Skip to main content</a>
  <div class="bg-field" aria-hidden="true"></div>

  <Nav />

  <main id="top">
    <Hero>
      <slot name="actions" slot="actions">
        <a class="btn btn-primary" href={isoRepo} target="_blank" rel="noopener">
          <Star size={16} /> Get the ISO
        </a>
        <a class="btn btn-ghost" href="#install">Watch it install</a>
      </slot>
    </Hero>

    <Features />
    <Desktop />
    <Install />
    <Languages />
    <CLI />
    <CTA />
  </main>

  <Footer />
</Layout>
