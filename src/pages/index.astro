---
import '../styles/global.css';
import Star from '../components/Star.astro';

const ghRepo = 'https://github.com/KornienkoDev/AestheticOS-Installer';
const isoRepo = 'https://github.com/KornienkoDev/AestheticOS';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="AestheticOS — a beautiful, fully offline Arch Linux distro. Boot it, run the installer, and get a polished Hyprland desktop. No internet, ever." />
    <meta name="theme-color" content="#faf7f6" />
    <title>AestheticOS — Beautiful, fully offline Arch Linux</title>
    <link rel="icon" type="image/svg+xml" href="/star.svg" />
  </head>
  <body>
    <div class="bg-field" aria-hidden="true"></div>

    <!-- ============ NAV ============ -->
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="#top">
          <span class="glyph"><Star size={18} /></span>
          <span>AestheticOS</span>
        </a>
        <nav class="nav-links">
          <a class="hide-mobile" href="#features">Features</a>
          <a class="hide-mobile" href="#desktop">Desktop</a>
          <a class="hide-mobile" href="#install">Install</a>
          <a class="btn-ghost" style="padding:0.55rem 1.1rem; font-size:0.9rem; border:1px solid var(--surface-border); border-radius:999px; color:var(--text);" href={ghRepo} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ============ HERO ============ -->
      <section class="section" style="padding-top: clamp(3rem, 7vw, 6rem);">
        <div class="container" style="display:grid; gap:3rem; align-items:center; grid-template-columns: 1.05fr 0.95fr;">
          <div class="reveal">
            <span class="eyebrow"><Star size={12} /> Fully offline · No internet required</span>
            <h1 class="section-title" style="margin-top:1.2rem; max-width: none; font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 900;">
              A beautiful <span class="text-gradient">offline</span> Arch Linux.
            </h1>
            <p style="margin-top:1.5rem; color:var(--text-dim); font-size:clamp(1.05rem,2.2vw,1.3rem); max-width: 52ch;">
              Boot the ISO. The installer starts on its own. You finish with a polished
              Hyprland desktop — no terminal, no network, no fuss.
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.9rem; margin-top:2rem;">
              <a class="btn btn-primary" href={isoRepo} target="_blank" rel="noopener">
                <Star size={16} /> Get the ISO
              </a>
              <a class="btn btn-ghost" href="#install">Watch it install</a>
            </div>

            <dl style="display:flex; flex-wrap:wrap; gap:2rem; margin-top:2.6rem;">
              <div><dt style="font-size:0.8rem; color:var(--text-faint); text-transform:uppercase; letter-spacing:0.1em;">Install time</dt><dd style="font-size:1.9rem; font-weight:800;">~1<span style="font-size:1rem;color:var(--text-dim)">min</span></dd></div>
              <div><dt style="font-size:0.8rem; color:var(--text-faint); text-transform:uppercase; letter-spacing:0.1em;">Installed size</dt><dd style="font-size:1.9rem; font-weight:800;">4.7<span style="font-size:1rem;color:var(--text-dim)">GB</span></dd></div>
              <div><dt style="font-size:0.8rem; color:var(--text-faint); text-transform:uppercase; letter-spacing:0.1em;">Network needed</dt><dd style="font-size:1.9rem; font-weight:800; color:var(--accent-green)">Never</dd></div>
            </dl>
          </div>

          <div class="reveal" style="transition-delay:120ms;">
            <div class="card hero-mockup" style="transform: rotate(-1.2deg); box-shadow: 0 40px 80px -30px rgba(0,0,0,0.8); border-color: var(--surface-border);">
              <div class="mockup-shell">
                <div class="mockup-titlebar">
                  <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
                  <span class="mockup-title">AestheticOS</span>
                  <span class="mockup-clock">12:00</span>
                </div>
                <div class="mockup-body">
                  <nav class="mockup-sidebar">
                    <span class="si si-1"></span><span class="si si-2"></span><span class="si si-3"></span><span class="si si-4"></span><span class="si si-5"></span>
                  </nav>
                  <div class="mockup-main">
                    <div class="mockup-widget">
                      <div class="mockup-colors">
                        <span style="background:#a67480"></span>
                        <span style="background:#8e7579"></span>
                        <span style="background:#a08864"></span>
                        <span style="background:#63e6a0"></span>
                      </div>
                      <b>Material You theming</b>
                      <div class="mockup-lines">
                        <i></i><i></i><i></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FEATURES ============ -->
      <section id="features" class="section">
        <div class="container">
          <div class="reveal">
            <span class="eyebrow">Why AestheticOS</span>
            <h2 class="section-title">Installs offline. Runs anywhere.</h2>
            <p class="section-sub">
              No flaky mirror fetches or missing packages during install — everything is baked into the ISO.
              It's a curated desktop, not a bare Arch you have to theme yourself.
            </p>
          </div>

          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:1.25rem; margin-top:3rem;">
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#9b7ff2;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">Fully offline, ever</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">Every package is embedded in the ISO and served from an embedded local mirror. Zero network dependency — not during install, not after. Boot it anywhere.</p>
              </div>
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#ff7ac6;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">Zero-touch boot</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">greetd launches a barebones Hyprland that starts the installer automatically on first boot. No manual commands, no thinking about it.</p>
              </div>
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#6fd0ff;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">Silent boot</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">A clean UEFI splash with the Plymouth BGRT theme shows your OEM logo — no console spam, no boot-time noise.</p>
              </div>
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#63e6a0;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">Auto monitor scaling</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">Detects the connected monitor and applies the right Hyprland scale automatically, so the installer is crisp on 1080p, 1440p, or 4K.</p>
              </div>
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#9b7ff2;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">~1 minute install</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">Because every package is already included, install takes about a minute and the complete OS uses roughly 4.7 GB after install.</p>
              </div>
              <div class="card" style="padding:1.75rem; height:100%;">
                <div class="dot" style="--c:#ff7ac6;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3 style="font-size:1.25rem; font-weight:700;">Zram swap</h3>
                <p style="margin-top:0.6rem; color:var(--text-dim);">Compressed RAM swap instead of a swap file — fast, responsive, and no disk space reserved for a swap file.</p>
              </div>
          </div>
        </div>
      </section>

      <!-- ============ DESKTOP / SOFTWARE ============ -->
      <section id="desktop" class="section" style="padding-top:0;">
        <div class="container">
          <div class="reveal">
            <span class="eyebrow">What you install</span>
            <h2 class="section-title">A finished desktop, not a checklist.</h2>
            <p class="section-sub">
              The installer hands you a complete, pre-configured system — ready to use the moment install finishes.
              GTK and Qt apps are matugen-themed out of the box, zero configuration required.
            </p>
          </div>

          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:1rem; margin-top:2.75rem;">
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">Hyprland</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">Dynamic tiling window manager with DankMaterialShell for a clean, modern look.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">DMS Greeter</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">greetd login — fast, elegant, and beautiful out of the box.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">matugen</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">Generates matching color schemes from your wallpaper automatically.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">Alacritty</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">A fast, GPU-accelerated terminal.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">Firefox</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">The browser, pre-configured and themed to match.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">PipeWire</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">Modern audio handling, ready to go.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">Plymouth BGRT</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">Silent boot splash reading your OEM logo from UEFI.</p>
              </div>
              <div class="card" style="padding:1.4rem;">
                <h3 style="font-weight:700; font-size:1.1rem;">GTK + Qt theming</h3>
                <p style="margin-top:0.4rem; color:var(--text-dim); font-size:0.95rem;">Matugen-themed out of the box — zero configuration required.</p>
              </div>
          </div>
        </div>
      </section>

      <!-- ============ INSTALL WIZARD ============ -->
      <section id="install" class="section">
        <div class="container">
          <div class="reveal">
            <span class="eyebrow">The installer</span>
            <h2 class="section-title">A few questions. That's it.</h2>
            <p class="section-sub">
              Just boot the ISO and answer a few questions in a clean wizard.
              No terminal, no internet, no fuss.
            </p>
          </div>

          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.1rem; margin-top:2.75rem;">
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">01</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Pick a language</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">Choose from 28 languages. This sets the installer UI, your system locale, and the mirror country.</p>
              </div>
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">02</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Create your user</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">Set up your account and password in a couple of fields.</p>
              </div>
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">03</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Choose a disk</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">Select the target drive and pick between ext4 or btrfs.</p>
              </div>
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">04</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Confirm</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">Review the summary, then hit install. That's it.</p>
              </div>
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">05</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Watch it go</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">The installer runs entirely from the live ISO — no internet needed.</p>
              </div>
              <div class="card" style="padding:1.6rem; height:100%; position:relative; overflow:hidden;">
                <span style="font-size:2.6rem; font-weight:900; line-height:1; background:linear-gradient(120deg,var(--accent),var(--accent-2)); -webkit-background-clip:text; background-clip:text; color:transparent;">06</span>
                <h3 style="margin-top:0.8rem; font-weight:700; font-size:1.15rem;">Boot into it</h3>
                <p style="margin-top:0.5rem; color:var(--text-dim);">Reboot into a finished Hyprland + DankMaterialShell desktop.</p>
              </div>
          </div>

          <div class="reveal" style="transition-delay:260ms;">
            <div class="card" style="margin-top:2.5rem; padding:1.75rem; display:flex; flex-wrap:wrap; gap:1.25rem; align-items:center; justify-content:space-between;">
              <div>
                <h3 style="font-weight:700; font-size:1.2rem;">ext4 or btrfs?</h3>
                <p style="margin-top:0.35rem; color:var(--text-dim);">btrfs ships with a sensible automatic subvolume layout.</p>
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:0.7rem;">
                <span class="card" style="padding:0.8rem 1.2rem; display:flex; align-items:center; gap:0.7rem; border-color: var(--accent);">
                  <code style="font-size:1.05rem;">btrfs</code>
                  <span style="font-size:0.72rem; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:0.08em;">recommended</span>
                </span>
                <span class="card" style="padding:0.8rem 1.2rem; display:flex; align-items:center; gap:0.7rem;">
                  <code style="font-size:1.05rem;">ext4</code>
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ LANGUAGE CHIPS ============ -->
      <section class="section" style="padding-top:0;">
        <div class="container">
          <div class="reveal" style="text-align:center; margin-bottom:1.5rem;">
            <p style="color:var(--text-faint); font-size:0.9rem; letter-spacing:0.05em; text-transform:uppercase;">The installer speaks 28 languages</p>
          </div>
          <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:0.6rem; max-width: 820px; margin-inline:auto;">
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">English</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Deutsch</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Français</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Español</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Italiano</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Português</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Русский</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Українська</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">中文</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">日本語</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">한국어</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Tiếng Việt</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Polski</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Nederlands</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Svenska</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Norsk</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Čeština</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Magyar</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Română</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Ελληνικά</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">Türkçe</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">עברית</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">hindi</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">বাংলা</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">தமிழ்</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">ไทย</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">पर्सी</span>
<span class="card" style="padding:0.5rem 1rem; font-size:0.9rem; color:var(--text-dim);">فارسی</span>
          </div>
        </div>
      </section>

      <!-- ============ CLI ============ -->
      <section class="section">
        <div class="container">
          <div class="reveal">
            <div class="card" style="background: var(--bg-elevated); border-color: var(--surface-border); overflow:hidden;">
              <div style="display:flex; align-items:center; gap:0.5rem; padding:0.9rem 1.2rem; border-bottom:1px solid var(--surface-border);">
                <span style="width:12px;height:12px;border-radius:50%;background:#ff5f56;"></span>
                <span style="width:12px;height:12px;border-radius:50%;background:#ffbd2e;"></span>
                <span style="width:12px;height:12px;border-radius:50%;background:#27c93f;"></span>
                <span style="margin-left:0.75rem; color:var(--text-faint); font-size:0.85rem; font-family:'JetBrains Mono',monospace;">aestheticos-installer-cli</span>
              </div>
              <pre style="margin:0; padding:1.4rem 1.3rem; overflow-x:auto; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:0.92rem; line-height:1.9; color:var(--text-dim);">
<code><span style="color:var(--accent-green)"># GUI</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer

<span style="color:var(--accent-green)"># CLI — full install</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer-cli <span style="color:var(--accent-2)">--install /dev/vda</span>

<span style="color:var(--accent-green)"># CLI — btrfs root instead of ext4</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer-cli <span style="color:var(--accent-2)">--install /dev/vda --filesystem btrfs</span></code></pre>
            </div>
            <p style="margin-top:1.2rem; color:var(--text-dim); max-width: 62ch;">
              Prefer headless or scripted installs? The installer also ships a CLI. It runs entirely from the live ISO — no internet connection required.
            </p>
          </div>
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="section" style="padding-top:0;">
        <div class="container">
          <div class="reveal">
            <div class="card" style="padding:clamp(2.5rem, 6vw, 4.5rem); text-align:center; background:radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--accent) 22%, transparent) 0%, transparent 60%); border-color: var(--surface-border);">
              <span class="eyebrow">Ready to boot?</span>
              <h2 style="margin-top:1.3rem; font-size:clamp(2rem, 5vw, 3rem); font-weight:800; max-width: 20ch; margin-inline:auto;">
                Boot it. Install it. <span class="text-gradient">Aesthetic it.</span>
              </h2>
              <p style="margin-top:1.1rem; color:var(--text-dim); max-width: 50ch; margin-inline:auto;">
                Flash the ISO to a USB (or <a href="https://www.ventoy.io/" target="_blank" rel="noopener" style="color:var(--accent);">Ventoy</a>), boot from it, and let the installer launch on its own.
              </p>
              <div style="display:flex; gap:0.9rem; justify-content:center; flex-wrap:wrap; margin-top:2rem;">
                <a class="btn btn-primary" href={isoRepo} target="_blank" rel="noopener"><Star size={16} /> View the ISO repo</a>
                <a class="btn btn-ghost" href={ghRepo} target="_blank" rel="noopener">Build the installer</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="container footer-row">
        <div style="display:flex; align-items:center; gap:0.6rem;">
          <span class="glyph" style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:grid;place-items:center;color:#12091c;"><Star size={15} /></span>
          <span>AestheticOS</span>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:1.5rem;">
          <a href={isoRepo} target="_blank" rel="noopener">AestheticOS (ISO)</a>
          <a href={ghRepo} target="_blank" rel="noopener">AestheticOS Installer</a>
          <a href="https://hyprland.org/" target="_blank" rel="noopener">Hyprland</a>
          <a href="https://wails.io/" target="_blank" rel="noopener">Wails v2</a>
        </div>
        <div>GPL-3.0</div>
      </div>
    </footer>

    <noscript><style>.reveal{opacity:1 !important;transform:none !important;transition:none !important}</style></noscript>
    <script client:load>
      document.documentElement.className += ' js';
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
    </script>
  </body>
</html>
