---
import '../styles/global.css';
import Star from '../components/Star.astro';

const ghRepo = 'https://github.com/KornienkoDev/AestheticOS-Installer';
const isoRepo = 'https://github.com/KornienkoDev/AestheticOS';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="AestheticOS — a beautiful, fully offline Arch Linux distro. Boot it, run the installer, and get a polished Hyprland desktop. No internet, ever." />
    <meta name="theme-color" content="#faf7f6" />
    <title>AestheticOS — Beautiful, fully offline Arch Linux</title>
    <link rel="icon" type="image/svg+xml" href="/star.svg" />
  </head>
  <body>
    <div class="bg-field" aria-hidden="true"></div>

    <!-- ============ NAV ============ -->
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="#top">
          <span class="glyph"><Star size={18} /></span>
          <span>AestheticOS</span>
        </a>
        <nav class="nav-links">
          <a class="hide-mobile" href="#features">Features</a>
          <a class="hide-mobile" href="#desktop">Desktop</a>
          <a class="hide-mobile" href="#install">Install</a>
          <a class="btn btn-ghost nav-gh" href={ghRepo} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ============ HERO ============ -->
      <section class="section hero-pad">
        <div class="container">
          <div class="hero-grid">
            <div class="reveal">
              <span class="eyebrow"><Star size={12} /> Fully offline · No internet required</span>
              <h1 class="section-title hero-title">
                A beautiful <span class="text-gradient">offline</span> Arch Linux.
              </h1>
              <p class="hero-lead">
                Boot the ISO. The installer starts on its own. You finish with a polished
                Hyprland desktop — no terminal, no network, no fuss.
              </p>
              <div class="flex gap-4 hero-actions">
                <a class="btn btn-primary" href={isoRepo} target="_blank" rel="noopener">
                  <Star size={16} /> Get the ISO
                </a>
                <a class="btn btn-ghost" href="#install">Watch it install</a>
              </div>

              <dl class="flex hero-stats gap-8">
                <div class="stat">
                  <dt>Install time</dt>
                  <dd>~1<span>min</span></dd>
                </div>
                <div class="stat">
                  <dt>Installed size</dt>
                  <dd>4.7<span>GB</span></dd>
                </div>
                <div class="stat">
                  <dt>Network needed</dt>
                  <dd class="stat-green">Never</dd>
                </div>
              </dl>
            </div>

            <div class="reveal hero-mockup-wrap" style="transition-delay:120ms;">
              <div class="card hero-mockup">
                <div class="mockup-shell">
                  <div class="mockup-titlebar">
                    <span class="dot-r"></span><span class="dot-y"></span><span class="dot-g"></span>
                    <span class="mockup-title">AestheticOS</span>
                    <span class="mockup-clock">12:00</span>
                  </div>
                  <div class="mockup-body">
                    <nav class="mockup-sidebar">
                      <span class="si si-1"></span><span class="si si-2"></span><span class="si si-3"></span><span class="si si-4"></span><span class="si si-5"></span>
                    </nav>
                    <div class="mockup-main">
                      <div class="mockup-widget">
                        <div class="mockup-colors">
                          <span style="background:#a67480"></span>
                          <span style="background:#8e7579"></span>
                          <span style="background:#a08864"></span>
                          <span style="background:#63e6a0"></span>
                        </div>
                        <b>Material You theming</b>
                        <div class="mockup-lines">
                          <i></i><i></i><i></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FEATURES ============ -->
      <section id="features" class="section">
        <div class="container">
          <div class="reveal section-head">
            <span class="eyebrow">Why AestheticOS</span>
            <h2 class="section-title">Installs offline. Runs anywhere.</h2>
            <p class="section-sub">
              No flaky mirror fetches or missing packages during install — everything is baked into the ISO.
              It's a curated desktop, not a bare Arch you have to theme yourself.
            </p>
          </div>

          <div class="card-grid" style="--cell-min:300px;">
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#9b7ff2;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>Fully offline, ever</h3>
                <p>Every package is embedded in the ISO and served from an embedded local mirror. Zero network dependency — not during install, not after. Boot it anywhere.</p>
              </div>
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#ff7ac6;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>Zero-touch boot</h3>
                <p>greetd launches a barebones Hyprland that starts the installer automatically on first boot. No manual commands, no thinking about it.</p>
              </div>
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#6fd0ff;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>Silent boot</h3>
                <p>A clean UEFI splash with the Plymouth BGRT theme shows your OEM logo — no console spam, no boot-time noise.</p>
              </div>
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#63e6a0;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>Auto monitor scaling</h3>
                <p>Detects the connected monitor and applies the right Hyprland scale automatically, so the installer is crisp on 1080p, 1440p, or 4K.</p>
              </div>
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#9b7ff2;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>~1 minute install</h3>
                <p>Because every package is already included, install takes about a minute and the complete OS uses roughly 4.7 GB after install.</p>
              </div>
              <div class="card card-pad-lg">
                <div class="dot" style="--c:#ff7ac6;"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5l2.1 6.4 6.9.6-5.2 4.4 1.9 6.7L12 16.9 5.3 20.6l1.9-6.7L1 8.5l6.9-.6L12 1.5z"></path></svg></div>
                <h3>Zram swap</h3>
                <p>Compressed RAM swap instead of a swap file — fast, responsive, and no disk space reserved for a swap file.</p>
              </div>
          </div>
        </div>
      </section>

      <!-- ============ DESKTOP / SOFTWARE ============ -->
      <section id="desktop" class="section section-no-top">
        <div class="container">
          <div class="reveal section-head">
            <span class="eyebrow">What you install</span>
            <h2 class="section-title">A finished desktop, not a checklist.</h2>
            <p class="section-sub">
              The installer hands you a complete, pre-configured system — ready to use the moment install finishes.
              GTK and Qt apps are matugen-themed out of the box, zero configuration required.
            </p>
          </div>

          <div class="card-grid" style="--cell-min:240px; --grid-gap: var(--space-4); --grid-top: var(--space-11, 2.75rem);">
              <div class="card card-pad-md">
                <h3>Hyprland</h3>
                <p>Dynamic tiling window manager with DankMaterialShell for a clean, modern look.</p>
              </div>
              <div class="card card-pad-md">
                <h3>DMS Greeter</h3>
                <p>greetd login — fast, elegant, and beautiful out of the box.</p>
              </div>
              <div class="card card-pad-md">
                <h3>matugen</h3>
                <p>Generates matching color schemes from your wallpaper automatically.</p>
              </div>
              <div class="card card-pad-md">
                <h3>Alacritty</h3>
                <p>A fast, GPU-accelerated terminal.</p>
              </div>
              <div class="card card-pad-md">
                <h3>Firefox</h3>
                <p>The browser, pre-configured and themed to match.</p>
              </div>
              <div class="card card-pad-md">
                <h3>PipeWire</h3>
                <p>Modern audio handling, ready to go.</p>
              </div>
              <div class="card card-pad-md">
                <h3>Plymouth BGRT</h3>
                <p>Silent boot splash reading your OEM logo from UEFI.</p>
              </div>
              <div class="card card-pad-md">
                <h3>GTK + Qt theming</h3>
                <p>Matugen-themed out of the box — zero configuration required.</p>
              </div>
          </div>
        </div>
      </section>

      <!-- ============ INSTALL WIZARD ============ -->
      <section id="install" class="section">
        <div class="container">
          <div class="reveal section-head">
            <span class="eyebrow">The installer</span>
            <h2 class="section-title">A few questions. That's it.</h2>
            <p class="section-sub">
              Just boot the ISO and answer a few questions in a clean wizard.
              No terminal, no internet, no fuss.
            </p>
          </div>

          <div class="card-grid" style="--cell-min:260px; --grid-gap: var(--space-4); --grid-top: var(--space-11, 2.75rem);">
              <div class="card card-pad-lg step-card">
                <span class="step-num">01</span>
                <h3>Pick a language</h3>
                <p>Choose from 28 languages. This sets the installer UI, your system locale, and the mirror country.</p>
              </div>
              <div class="card card-pad-lg step-card">
                <span class="step-num">02</span>
                <h3>Create your user</h3>
                <p>Set up your account and password in a couple of fields.</p>
              </div>
              <div class="card card-pad-lg step-card">
                <span class="step-num">03</span>
                <h3>Choose a disk</h3>
                <p>Select the target drive and pick between ext4 or btrfs.</p>
              </div>
              <div class="card card-pad-lg step-card">
                <span class="step-num">04</span>
                <h3>Confirm</h3>
                <p>Review the summary, then hit install. That's it.</p>
              </div>
              <div class="card card-pad-lg step-card">
                <span class="step-num">05</span>
                <h3>Watch it go</h3>
                <p>The installer runs entirely from the live ISO — no internet needed.</p>
              </div>
              <div class="card card-pad-lg step-card">
                <span class="step-num">06</span>
                <h3>Boot into it</h3>
                <p>Reboot into a finished Hyprland + DankMaterialShell desktop.</p>
              </div>
          </div>

          <div class="reveal step-cta">
            <div class="card card-pad-lg flex-row between">
              <div class="stack gap-2" style="align-items:flex-start;">
                <h3>ext4 or btrfs?</h3>
                <p>btrfs ships with a sensible automatic subvolume layout.</p>
              </div>
              <div class="flex gap-3">
                <span class="card selected-fs">
                  <code>btrfs</code>
                  <span>recommended</span>
                </span>
                <span class="card">
                  <code>ext4</code>
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ LANGUAGE CHIPS ============ -->
      <section class="section section-no-top">
        <div class="container">
          <div class="reveal center-block lang-head">
            <p>The installer speaks 28 languages</p>
          </div>
          <div class="flex flex-wrap justify-center lang-chips">
<span class="card lang-chip">English</span>
<span class="card lang-chip">Deutsch</span>
<span class="card lang-chip">Français</span>
<span class="card lang-chip">Español</span>
<span class="card lang-chip">Italiano</span>
<span class="card lang-chip">Português</span>
<span class="card lang-chip">Русский</span>
<span class="card lang-chip">Українська</span>
<span class="card lang-chip">中文</span>
<span class="card lang-chip">日本語</span>
<span class="card lang-chip">한국어</span>
<span class="card lang-chip">Tiếng Việt</span>
<span class="card lang-chip">Polski</span>
<span class="card lang-chip">Nederlands</span>
<span class="card lang-chip">Svenska</span>
<span class="card lang-chip">Norsk</span>
<span class="card lang-chip">Čeština</span>
<span class="card lang-chip">Magyar</span>
<span class="card lang-chip">Română</span>
<span class="card lang-chip">Ελληνικά</span>
<span class="card lang-chip">Türkçe</span>
<span class="card lang-chip">עברית</span>
<span class="card lang-chip">hindi</span>
<span class="card lang-chip">বাংলা</span>
<span class="card lang-chip">தமிழ்</span>
<span class="card lang-chip">ไทย</span>
<span class="card lang-chip">पर्सी</span>
<span class="card lang-chip">فارسی</span>
          </div>
        </div>
      </section>

      <!-- ============ CLI ============ -->
      <section class="section">
        <div class="container">
          <div class="reveal section-head">
            <div class="card cli-card">
              <div class="cli-titlebar">
                <span class="cli-dot cli-dot-r"></span>
                <span class="cli-dot cli-dot-y"></span>
                <span class="cli-dot cli-dot-g"></span>
                <span class="cli-title">aestheticos-installer-cli</span>
              </div>
              <pre class="cli-code"><code><span style="color:var(--accent-green)"># GUI</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer

<span style="color:var(--accent-green)"># CLI — full install</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer-cli <span style="color:var(--accent-2)">--install /dev/vda</span>

<span style="color:var(--accent-green)"># CLI — btrfs root instead of ext4</span>
<span style="color:var(--accent-3)">sudo</span> ./build/bin/aestheticos-installer-cli <span style="color:var(--accent-2)">--install /dev/vda --filesystem btrfs</span></code></pre>
            </div>
            <p class="cli-note">
              Prefer headless or scripted installs? The installer also ships a CLI. It runs entirely from the live ISO — no internet connection required.
            </p>
          </div>
        </div>
      </section>

      <!-- ============ CTA ============ -->
      <section class="section section-no-top">
        <div class="container">
          <div class="reveal">
            <div class="card cta-card">
              <span class="eyebrow center-block">Ready to boot?</span>
              <h2 class="cta-title">
                Boot it. Install it. <span class="text-gradient">Aesthetic it.</span>
              </h2>
              <p class="cta-sub">
                Flash the ISO to a USB (or <a href="https://www.ventoy.io/" target="_blank" rel="noopener" style="color:var(--accent);">Ventoy</a>), boot from it, and let the installer launch on its own.
              </p>
              <div class="flex justify-center gap-4 cta-actions">
                <a class="btn btn-primary" href={isoRepo} target="_blank" rel="noopener"><Star size={16} /> View the ISO repo</a>
                <a class="btn btn-ghost" href={ghRepo} target="_blank" rel="noopener">Build the installer</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="container footer-row">
        <div class="flex items-center gap-3 footer-brand">
          <span class="glyph footer-glyph"><Star size={15} /></span>
          <span>AestheticOS</span>
        </div>
        <div class="flex flex-wrap items-center gap-6 footer-links">
          <a href={isoRepo} target="_blank" rel="noopener">AestheticOS (ISO)</a>
          <a href={ghRepo} target="_blank" rel="noopener">AestheticOS Installer</a>
          <a href="https://hyprland.org/" target="_blank" rel="noopener">Hyprland</a>
          <a href="https://wails.io/" target="_blank" rel="noopener">Wails v2</a>
        </div>
        <div>GPL-3.0</div>
      </div>
    </footer>

    <noscript><style>.reveal{opacity:1 !important;transform:none !important;transition:none !important}</style></noscript>
    <script client:load>
      document.documentElement.className += ' js';
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
    </script>
  </body>
</html>
