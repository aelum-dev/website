---
import "../styles/base.css";
import "../styles/home.css";
import "../styles/download.css";
import "../styles/install.css";
import "../styles/features.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Install from "../components/Install.astro";
import Features from "../components/Features.astro";
import Desktop from "../components/Desktop.astro";
import Languages from "../components/Languages.astro";
import CLI from "../components/CLI.astro";
import CTA from "../components/CTA.astro";
import DownloadPage from "../components/Download.astro";
import Footer from "../components/Footer.astro";

const title = "Aelum — an Arch Linux distro with an offline installer";
const description =
  "Aelum — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Aelum",
        "operatingSystem": "Arch Linux",
        "description": "Aelum — an Arch Linux distro whose installer works fully offline. Boot it, run the installer, and end up with a Hyprland + DankMaterialShell desktop. The install needs no internet; the installed system uses the internet like any other Arch machine.",
        "applicationCategory": "System Tool",
        "url": "https://aelum.gitlab.io/website/"
      }
    </script>
  </Fragment>

  <a class="skip-link" href="#top">Skip to main content</a>
  <div class="bg-field" aria-hidden="true">
    <span class="orb"></span>
  </div>

  <Nav />

  <main id="top">
    <!-- Home -->
    <section id="home" class="page active" aria-label="Home">
      <Hero>
        <slot name="actions" slot="actions">
          <a class="btn btn-primary" href="#download" data-page="download">
            <span class="nf-icon" aria-hidden="true" style="font-size:1.6rem">
              {String.fromCodePoint(0xf0ed)}
            </span>Download
          </a>
          <a
            class="btn btn-ghost"
            href="#install"
            data-page="install"
          >
            Watch it install
          </a>
        </slot>
      </Hero>
      <CTA />
    </section>

    <!-- Download -->
    <section id="download" class="page" aria-label="Download">
      <DownloadPage />
    </section>

    <!-- Install -->
    <section id="install" class="page" aria-label="Install">
      <Install />
    </section>

    <!-- Desktop + Features -->
    <section id="features" class="page" aria-label="Features">
      <Desktop />
      <Features />
      <Languages />
      <CLI />
    </section>
  </main>

  <Footer />
</Layout>
