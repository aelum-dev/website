---
import "../styles/base.css";
import "../styles/features.css";
import Desktop from "../components/Desktop.astro";
import Features from "../components/Features.astro";
import Layout from "../layouts/Layout.astro";
import Look from "../components/Look.astro";

const title = "Features — the desktop, set up before your first login";
const description =
  "What ships with Aelum: Hyprland with Dux Shell, wallpaper-driven Material You theming, bootable snapshots with rollback, optional LUKS2, a branded boot, the graphics driver chosen for your card, Aelum's own media player and package manager updated through pacman, and 32-bit support already enabled.";
---

<Layout title={title} description={description} active="features">
  <Desktop />
  <Look />
  <Features />
</Layout>
