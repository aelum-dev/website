---
import Layout from "../layouts/Layout.astro";
import "../styles/base.css";
import { mainRepo } from "../lib/site";
---

<Layout title="404 — Not found | Aelum" description="Page not found for Aelum.">
  <div class="bg-field" aria-hidden="true"></div>
  <main class="not-found">
    <div class="container not-found-card">
      <span class="glyph">🚀</span>
      <h1>404</h1>
      <p>This page drifted off into space.</p>
      <a class="btn btn-primary" href="index.html">Back to home</a>
      <a
        class="btn btn-ghost"
        href={mainRepo}
        target="_blank"
        rel="noopener"
      >
        View the ISO repo
      </a>
    </div>
  </main>
</Layout>
