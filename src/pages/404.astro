---
import "../styles/base.css";
import Layout from "../layouts/Layout.astro";
import { mainRepo, navLinks } from "../lib/site";

const home = navLinks[0].href;
---

<Layout
  title="404 — Not found | Aelum"
  description="Page not found on aelum.dev."
  active="home"
  showCta={false}
>
  <section class="not-found">
    <div class="container not-found-card">
      <span class="glyph" aria-hidden="true">
        <span class="nf-icon">&#xf0ed;</span>
      </span>
      <span class="eyebrow">Error 404</span>
      <h1>Page not found</h1>
      <p>That page isn't here. Let's get you back.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={home}>Back to home</a>
        <a class="btn btn-ghost" href={mainRepo} target="_blank" rel="noopener">
          View the ISO repo
        </a>
      </div>
    </div>
  </section>
</Layout>
