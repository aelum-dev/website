---
// Shared document shell: owns the <head> boilerplate (meta tags, OG/Twitter
// cards, favicon, theme scripts) so pages don't duplicate it.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Derive canonical / OG image URLs from Astro's config so the base path and
// site URL stay in a single place (astro.config.mjs) instead of being
// hardcoded in every page.
const canonical = Astro.url.href;
const imageUrl = new URL("og-image.png", Astro.url).href;
---

<html lang="en" class="no-js">
  <head>
    <!-- Flip no-js -> js before first paint so the router CSS can hide the
      inactive pages immediately (no flash of every page at once). This stays a
      classic, non-deferred script on purpose: Astro renders bare inline scripts
      as modules, which are deferred and would run after first paint and defeat
      this intent. A synchronous classic script runs during parsing, before paint. -->
    <script type="text/javascript" is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Reflect both schemes so form controls/scrollbars match the active theme. -->
    <meta name="color-scheme" content="dark light" />
    <!-- theme-color set dynamically by theme.js to match the active scheme -->
    <meta name="theme-color" content="" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Aelum" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <link rel="icon" type="image/png" href="favicon-16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="favicon-32.png" sizes="32x32" />

    <!-- Theme must be applied before first paint to avoid a flash. -->
    <script src="scripts/theme.js" is:inline></script>

    <!-- Pages can inject extra head markup (e.g. structured data) here. -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Client router: runs before first paint (defer) to set the active page. -->
    <script src="scripts/app.js" defer is:inline></script>
    <script src="scripts/theme-toggle.js" is:inline></script>
  </body>
</html>
