---
// Shared document shell AND site chrome.
//
// With real routes there is one document per page, so the parts that are the
// same on every page (skip link, ambient background, nav, call-to-action,
// footer) live here instead of being repeated in each page template. A page
// supplies only its own <head> metadata and its <section> content.
//
// Asset URLs in this file are absolute from the site root (/logo.svg,
// /scripts/theme.js). Pages are served at nested routes (/download/), where a
// relative URL would resolve inside that directory and 404.
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import type { PageId } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Which nav item represents this page. Drives the active state server-side. */
  active: PageId;
  /** Set false where the page already carries its own download buttons (Home, Download). */
  showCta?: boolean;
}

const { title, description, active, showCta = true } = Astro.props;

// Derive canonical / OG image URLs from Astro's config so the base path and
// site URL stay in a single place (astro.config.mjs) instead of being hardcoded in every page.
const canonical = Astro.url.href;
const imageUrl = new URL("og-image.png", Astro.url).href;
---

<html lang="en" class="no-js">
  <head>
    <!-- Flip no-js -> js before first paint. This stays a classic, non-deferred
      script on purpose: Astro renders bare inline scripts as modules, which are
      deferred and would run after first paint. -->
    <script type="text/javascript" is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Reflect both schemes so form controls/scrollbars match the active theme. -->
    <meta name="color-scheme" content="dark light" />
    <!-- theme-color set dynamically by theme.js to match the active scheme -->
    <meta name="theme-color" content="" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Aelum" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />

    <!-- Theme must be applied before first paint to avoid a flash. -->
    <script src="/scripts/theme.js" is:inline></script>

    <!-- Pages can inject extra head markup (e.g. structured data) here. -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to main content</a>
    <!-- Reading progress for the current document, pinned to the top edge of the
      window. Site chrome rather than nav chrome: it measures the page, and the
      nav is just the first thing on it. --scroll (0…1) is set by app.js. -->
    <div class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-bar"></span>
    </div>
    <!-- Ambient field layers (see base.css → Ambient background). Decorative, so
      one aria-hidden container and nothing inside it is focusable. -->
    <div class="bg-field" aria-hidden="true">
      <span class="bg-aurora bg-aurora--a"></span>
      <span class="bg-aurora bg-aurora--b"></span>
      <span class="bg-grid"></span>
      <span class="bg-grain"></span>
      <span class="bg-spot"></span>
    </div>

    <Nav active={active} />

    <main id="top">
      <slot />
    </main>

    {showCta && <CTA />}
    <Footer />

    <!-- Client behaviour (nav scroll state, reveals, clipboard, card glow).
      Page switching is server-side routing; nothing here decides what renders. -->
    <script src="/scripts/app.js" defer is:inline></script>
    <script src="/scripts/theme-toggle.js" is:inline></script>
  </body>
</html>
