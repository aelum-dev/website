---
import {
  balenaEtcherUrl,
  checksums,
  downloadUrl,
  isoFilename,
  isoSizeLabel,
  releaseArch,
  releasePublishedAt,
  releaseVersion,
  requirements,
  signingKey,
  ventoyUrl,
  verifyCommands,
  wkdKeyUrl,
} from "../lib/site";
import CopyButton from "./CopyButton.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

// The size string comes from site.ts (isoSizeLabel), which is the same one the
// landing-page stats use — one file must never be two different sizes.
const isoDate = releasePublishedAt.slice(0, 10);

// Release assets offered for download, in the order users need them.
const assets = [
  {
    icon: "f02ca",
    name: "Disk image",
    sub: isoFilename,
    href: downloadUrl.iso,
  },
  {
    icon: "f012c",
    name: "SHA-256 checksum",
    sub: `${isoFilename}.sha256`,
    href: downloadUrl.sha256,
  },
  ...(checksums.sha512 && downloadUrl.sha512
    ? [
        {
          icon: "f012c",
          name: "SHA-512 checksum",
          sub: `${isoFilename}.sha512`,
          href: downloadUrl.sha512,
        },
      ]
    : []),
  {
    icon: "ee3c",
    name: "GPG signature",
    sub: `${isoFilename}.asc`,
    href: downloadUrl.signature,
  },
];

// The three commands a user runs to verify a download. The command strings come
// from site.ts so they always match the real filenames and signing email.
const verifySteps = [
  {
    num: "01",
    title: "Get the signing key",
    body: "WKD lets GPG pull the release key straight from aelum.dev by email — no keyserver, no manual import.",
    command: verifyCommands.fetchKey,
  },
  {
    num: "02",
    title: "Check the checksum",
    body: "Run this in the folder with your downloads. It re-hashes the ISO and compares it with the published value.",
    command: verifyCommands.checksum,
  },
  {
    num: "03",
    title: "Verify the signature",
    body: "Confirms the ISO was signed by the Aelum release key and hasn't been altered since.",
    command: verifyCommands.signature,
  },
];

const flashTools = [
  {
    title: "Ventoy",
    icon: "ede9",
    cta: { href: ventoyUrl, label: "Get Ventoy" },
    steps: [
      `Download and open Ventoy on your computer.`,
      `Select your USB drive, then click <code>Install</code>.`,
      `Copy <code>{isoFilename}</code> onto the USB drive.`,
      `Boot your computer from that USB drive.`,
    ],
  },
  {
    title: "BalenaEtcher",
    icon: "f02e9",
    cta: { href: balenaEtcherUrl, label: "Get BalenaEtcher" },
    steps: [
      `Download and open BalenaEtcher on your computer.`,
      `Choose <code>{isoFilename}</code> as the image to flash.`,
      `Select your USB drive, then click <code>Flash!</code>.`,
      `Boot your computer from that USB drive.`,
    ],
  },
  {
    title: "dd (Linux / macOS)",
    icon: "f120",
    // dd ships with the OS, so there is nothing to download.
    cta: null,
    steps: [
      `Plug in your USB drive and find its device name with <code>lsblk</code>.`,
      `Run <code>dd if={isoFilename} of=DEVICE bs=4M status=progress</code>, replacing <code>DEVICE</code> with your drive (for example <code>/dev/sdb</code>).`,
      `Boot your computer from that USB drive.`,
    ],
  },
];
---

<section class="section">
  <div class="container">
    <div class="dl-hero-grid">
      <div class="dl-hero-left section-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf0ed;</span>
          </span>
          Aelum {releaseVersion} · {releaseArch}
        </span>
        <h2 class="section-title">Download Aelum.</h2>
        <p class="dl-hero-lead">
          The bootable installer ISO. Flash it to a USB drive and boot from it —
          the installer starts automatically and sets up Aelum fully offline, no
          internet needed.
        </p>

        <div class="dl-req">
          <span class="dl-req-label">System requirements</span>
          <ul class="dl-req-list">
            {requirements.map((need) => <li>{need}</li>)}
          </ul>
        </div>
      </div>

      <div class="dl-hero-right reveal">
        <div class="card card-pad-lg dl-iso-card">
          <div class="card-head">
            <span class="icon-tile" aria-hidden="true">
              <span class="nf-icon">{glyph("ede9")}</span>
            </span>
            <div class="card-head-text">
              <h3>Installation media</h3>
            </div>
          </div>

          <div class="copy-field">
            <span class="copy-field-label">File</span>
            <code>{isoFilename}</code>
            <span class="copy-field-size">{isoSizeLabel}</span>
            <CopyButton value={isoFilename} label="Copy filename" />
          </div>

          <div class="dl-iso-actions">
            <a
              class="btn btn-primary btn-lg"
              href={downloadUrl.iso}
              target="_blank"
              rel="noopener"
            >
              <span class="nf-icon" aria-hidden="true">
                {glyph("f0ed")}
              </span>
              Download ISO
            </a>
            <a class="btn btn-ghost btn-lg" href="#install-tools">
              How to flash it
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf012c;</span>
        </span>
        Verify
      </span>
      <h2 class="section-title">Check your download.</h2>
      <p class="section-sub">
        Every Aelum release is signed with the Aelum release key. Check the
        checksum, then verify the signature before you flash anything.
      </p>
    </div>

    <div class="card-grid grid-verify">
      <div class="card card-pad-lg dl-assets reveal">
        <div class="card-head">
          <span class="icon-tile" aria-hidden="true">
            <span class="nf-icon">{glyph("f0965")}</span>
          </span>
          <div class="card-head-text">
            <span class="card-badge">{isoSizeLabel} · {isoDate}</span>
            <h3>Release assets</h3>
          </div>
        </div>
        <ul class="dl-asset-list">
          {
            assets.map((asset) => (
              <li class="dl-asset">
                <span class="dl-asset-icon" aria-hidden="true">
                  <span class="nf-icon">{glyph(asset.icon)}</span>
                </span>
                <span class="dl-asset-text">
                  <span class="dl-asset-name">{asset.name}</span>
                  <span class="dl-asset-sub">{asset.sub}</span>
                </span>
                <a
                  class="dl-asset-btn"
                  href={asset.href}
                  target="_blank"
                  rel="noopener"
                  title={`Download ${asset.sub}`}
                  aria-label={`Download ${asset.sub}`}
                >
                  <span class="nf-icon" aria-hidden="true">{glyph("f0965")}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card card-pad-lg dl-key-card reveal">
        <div class="card-head">
          <span class="icon-tile" aria-hidden="true">
            <span class="nf-icon">{glyph("eb11")}</span>
          </span>
          <h3>Signing key</h3>
          <CopyButton
            value={signingKey.fingerprint}
            label="Copy full fingerprint"
            className="dl-key-copy"
          />
        </div>
        <div class="dl-key">
          <span class="dl-key-uid">{signingKey.uid}</span>
          <span class="dl-key-fp">{signingKey.fingerprintTop}</span>
          <span class="dl-key-fp">{signingKey.fingerprintBot}</span>
          <span class="dl-key-exp">
            {signingKey.expires === "never" ? "No expiry" : `Expires ${signingKey.expires}`}
          </span>
        </div>
        <p class="dl-key-wkd">
          Get this key over <strong>WKD</strong> — GPG fetches it straight from{" "}
          <a href={wkdKeyUrl} target="_blank" rel="noopener">
            aelum.dev
          </a>{" "}
          by email, so there's no keyserver and nothing to import by hand.
        </p>
      </div>
    </div>

    <div class="dl-steps reveal">
      <h3 class="dl-steps-title">
        <span class="nf-icon" aria-hidden="true">{glyph("f120")}</span>
        Verify in three commands
      </h3>
      <p class="dl-steps-note">
        Download the files above into one folder, then run these there — one line
        each.
      </p>
      <ol class="dl-step-list">
        {
          verifySteps.map((step) => (
            <li class="dl-step">
              <span class="dl-step-num">{step.num}</span>
              <div class="dl-step-body">
                <h4>{step.title}</h4>
                <p>{step.body}</p>
                <div class="dl-code">
                  <code>{step.command}</code>
                  <CopyButton value={step.command} label="Copy command" />
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section class="section" id="install-tools">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf02ca;</span>
        </span>
        Before you boot
      </span>
      <h2 class="section-title">Flash it to a USB drive.</h2>
      <p class="section-sub">
        Any of these puts the {isoSizeLabel} ISO on a USB stick. Ventoy keeps the
        stick usable for other files; BalenaEtcher does a single-image flash; dd
        is a built-in command line tool.
      </p>
    </div>

    <div class="card-grid grid-flash">
      {
        flashTools.map((tool) => (
          <div class="card card-pad-md flash-card">
            <div class="card-head">
              <span class="icon-tile" aria-hidden="true">
                <span class="nf-icon">{glyph(tool.icon)}</span>
              </span>
              <h3>{tool.title}</h3>
            </div>
            <ol class="flash-steps">
              {tool.steps.map((step) => (
                <li set:html={step.replace("{isoFilename}", isoFilename)} />
              ))}
            </ol>
            {tool.cta && (
              <a
                class="btn btn-primary"
                href={tool.cta.href}
                target="_blank"
                rel="noopener"
              >
                <span class="nf-icon" aria-hidden="true">
                  {glyph("f08e")}
                </span>
                {tool.cta.label}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
