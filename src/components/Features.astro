---
import { features } from "../lib/site";
import Card from "./Card.astro";
---

<section class="section">
  <div class="container">
    <div class="features-grid">
      <div class="section-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf108;</span>
          </span>
          The installed system
        </span>
        <h2 class="section-title">What your machine does after the install.</h2>
        <p class="section-sub">
          The installer itself lives on the install page. This is what your
          computer does from the first boot on — everything here ships
          configured and needs no setup pass.
        </p>
      </div>

      <div>
        <div class="card-grid grid-features">
          {
            features.map((feature) => (
              <Card
                title={feature.title}
                icon={feature.icon}
                description={feature.description}
                size="lg"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
