---
import Card from "./Card.astro";
import { features } from "../lib/site";
---

<section id="features" class="section section-no-top">
  <div class="container">
    <div class="reveal section-head">
      <span class="eyebrow">Why AestheticOS</span>
      <h2 class="section-title">Installs offline. Runs anywhere.</h2>
      <p class="section-sub">
        No flaky mirror fetches or missing packages during install — everything
        is baked into the ISO. It's a curated desktop, not a bare Arch you have
        to theme yourself.
      </p>
    </div>

    <div class="card-grid grid-features">
      {
        features.map((feature) => (
          <Card
            title={feature.title}
            description={feature.description}
            color={feature.color}
            size="lg"
          />
        ))
      }
    </div>
  </div>
</section>
