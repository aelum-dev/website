---
import { features } from "../lib/site";
import Card from "./Card.astro";
---

<section class="section">
  <div class="container">
    <div class="features-grid">
      <div class="section-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf108;</span>
          </span>
          The installed system
        </span>
        <h2 class="section-title">What the installed system does</h2>
        <p class="section-sub">
          Once the install finishes, your machine keeps doing its part: on a
          btrfs install it takes a snapshot around every pacman transaction, the
          desktop colors itself from your wallpaper, and the system boots with
          its own entry in the rEFInd menu. All of that is configured already,
          so there is nothing left to set up.
        </p>
      </div>

      <div>
        <div class="card-grid grid-features">
          {
            features.map((feature) => (
              <Card
                title={feature.title}
                icon={feature.icon}
                description={feature.description}
                size="lg"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
