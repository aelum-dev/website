---
import { features } from "../lib/site";
import Card from "./Card.astro";
---

<section class="section">
  <div class="container">
    <div class="features-grid">
      <div class="section-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf05aa;</span>
          </span>
          The installer ISO
        </span>
        <h2 class="section-title">An install that needs no network</h2>
        <p class="section-sub">
          The installer's packages come from inside the ISO, so there is no
          mirror to fetch and nothing to install by hand afterwards. It writes a
          themed desktop, not a bare Arch you have to set up yourself.
        </p>
      </div>

      <div>
        <div class="card-grid grid-features">
          {
            features.map((feature) => (
              <Card
                title={feature.title}
                icon={feature.icon}
                description={feature.description}
                size="lg"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
