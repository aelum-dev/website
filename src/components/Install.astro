---
import { installSteps } from "../lib/site";
import Shot from "./Shot.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

const slides = [
  { n: 1, alt: "welcome screen" },
  { n: 2, alt: "creating the user account" },
  { n: 3, alt: "selecting a disk" },
  { n: 4, alt: "partitioning the disk" },
  { n: 5, alt: "confirming installation" },
  { n: 6, alt: "installing the system" },
  { n: 7, alt: "installation complete" },
];
---

<section class="section">
  <div class="container">
    <div class="install-grid">
      <div class="install-visual reveal">
        <div class="features-demo-frame">
          <span class="frame-ring" aria-hidden="true"></span>
          <div
            class="slideshow"
            role="group"
            aria-label="Aelum installer walkthrough"
          >
            {
              slides.map((s) => (
                <div class="slideshow-slide">
                  <Shot
                    light={`installer-step-${s.n}-light`}
                    dark={`installer-step-${s.n}-dark`}
                    alt={`Aelum installer — ${s.alt}`}
                    sizes="(max-width: 620px) 100vw, 620px"
                    eager={s.n === 1}
                    defer={s.n !== 1}
                    class="shot"
                  />
                </div>
              ))
            }
          </div>
          <!-- One segment per slide; the active one fills as the pause runs out.
            Decorative: the walkthrough itself is announced by the group above. -->
          <span class="frame-progress" aria-hidden="true">
            {slides.map(() => <span class="frame-seg"></span>)}
          </span>
        </div>
      </div>

      <div class="section-head install-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf02ca;</span>
          </span>
          The installer
        </span>
        <h2 class="section-title">The installer asks four questions</h2>
        <p class="section-sub">
          Boot the ISO on a UEFI machine with a GPT disk and at least 8 GB free.
          The wizard asks for a language, a user, a disk and a confirmation. You
          don't need a terminal, and the installer downloads nothing.
        </p>
      </div>

      <script type="text/javascript" is:inline>
        // Auto-advancing installer walkthrough.
        //
        // The slides are all in the document, but only the one you are looking at
        // (and the one about to appear) has an image behind it: slides 2-7 are
        // built with Shot's `defer`, so their <picture> carries both theme sets
        // in data-aelum-* and fetches nothing until the walkthrough reaches it.
        // With JavaScript off the first slide is a normal, loaded screenshot and
        // the rest stay empty — which is fine, because they are hidden either
        // way. See Shot.astro → defer for why `loading="lazy"` was not enough.
        //
        // It stops on its own when the frame is not on screen, and it never
        // starts at all when the system says it should not move. install.css
        // pauses the segment fill animation inside any section app.js has not
        // marked .is-live (see base.css → Off-screen loops); a timer that kept
        // advancing while its own progress bar was paused would walk out of step
        // with it, and the frame would resume mid-slide.
        //
        // Hovering does not stop it. The walkthrough is a preview of a wizard you
        // have not run yet — holding it under the pointer to read one screen is
        // not a request to freeze the rest, and a pointer that happens to be over
        // the frame is indistinguishable from that. Chrome also does not re-run
        // its hit test until the mouse moves, so scrolling the frame away under a
        // still pointer used to leave it paused with no mouseleave to undo it.
        (function () {
          var frame = document.querySelector(".features-demo-frame");
          if (!frame) return;
          var order = Array.prototype.slice.call(
            frame.querySelectorAll(".slideshow-slide"),
          );
          if (order.length < 2) return;
          var segments = Array.prototype.slice.call(
            frame.querySelectorAll(".frame-seg"),
          );
          var index = 0;
          var timer = null;
          var PAUSE = 3500;
          var onScreen = true;
          var tracked = false;
          // Reduced motion means "do not move it for me": the first screen is
          // shown and nothing advances it.
          var stopped = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

          // A deferred <picture> is loaded the same way theme.js loads a visible
          // one: copy the set that matches the theme the page is actually in.
          // The marker comes off afterwards, so from here on theme.js owns it —
          // which is what keeps a screenshot from ever disagreeing with a theme.
          function load(slide) {
            var picture = slide.querySelector("picture[data-shot-defer]");
            if (!picture) return;
            var source = picture.querySelector('source[data-aelum-type="avif"]');
            var img = picture.querySelector("img");
            if (!source || !img) return;
            var light =
              document.documentElement.getAttribute("data-theme") === "light";
            var ladder = light
              ? picture.dataset.aelumAvifLight
              : picture.dataset.aelumAvifDark;
            var fallback = light
              ? picture.dataset.aelumSrcLight
              : picture.dataset.aelumSrcDark;
            if (!ladder || !fallback) return;
            source.setAttribute("srcset", ladder);
            img.setAttribute("src", fallback);
            picture.removeAttribute("data-shot-defer");
          }

          function show(i) {
            index = (i + order.length) % order.length;
            order.forEach(function (s, n) {
              s.classList.toggle("is-active", n === index);
            });
            segments.forEach(function (seg, n) {
              seg.classList.toggle("is-active", n === index);
              // Restart the fill animation on the newly active segment.
              if (n === index) {
                seg.style.animation = "none";
                void seg.offsetWidth;
                seg.style.animation = "";
              }
            });
            load(order[index]);
            // The next screen is the one about to fade in: warm it while this one
            // is up, so the cross-fade never has a fetch in the middle of it.
            load(order[(index + 1) % order.length]);
          }

          function start() {
            if (timer || stopped) return;
            timer = setInterval(function () {
              show(index + 1);
            }, PAUSE);
          }

          function stop() {
            if (!timer) return;
            clearInterval(timer);
            timer = null;
          }

          // Off screen, or a reduced-motion request: either one stops it.
          function sync() {
            if (stopped || (tracked && !onScreen)) stop();
            else start();
          }

          show(0);
          sync();

          if (!("IntersectionObserver" in window)) {
            start();
            return;
          }

          var io = new IntersectionObserver(
            function (entries) {
              onScreen = entries[entries.length - 1].isIntersecting;
              tracked = true;
              sync();
            },
            { rootMargin: "200px 0px 200px 0px", threshold: 0 },
          );
          io.observe(frame);
        })();
      </script>
    </div>

    <div class="card-grid grid-steps">
      {
        installSteps.map((step) => (
          <div class="card card-pad-lg card--interactive step-card">
            <span class="step-num" aria-hidden="true">
              {step.num}
            </span>
            <span class="icon-tile" aria-hidden="true">
              <span class="nf-icon">{glyph(step.icon)}</span>
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
