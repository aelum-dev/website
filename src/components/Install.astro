---
import { installSteps } from "../lib/site";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

const slides = [
  { n: 1, alt: "language selection", dark: "38d5732e", light: "6d1c7201" },
  { n: 2, alt: "creating the user account", dark: "e6ba2eca", light: "07d02c0c" },
  { n: 3, alt: "selecting a disk", dark: "27bca97b", light: "0ecfebc7" },
  { n: 4, alt: "partitioning the disk", dark: "15386dcd", light: "e1ed8651" },
  { n: 5, alt: "confirming installation", dark: "46ff0530", light: "eb9c208c" },
  { n: 6, alt: "installing the system", dark: "f3a374ac", light: "2e4ca679" },
  { n: 7, alt: "installation complete", dark: "ccabadb0", light: "414a3186" },
];
---

<section class="section">
  <div class="container">
    <div class="install-grid">
      <div class="install-visual reveal">
        <div class="features-demo-frame">
          <div
            class="slideshow"
            role="group"
            aria-label="Aelum installer walkthrough"
          >
            {
              slides.map((s) => (
                <div class="slideshow-slide">
                  <img
                    class="shot shot--dark"
                    src={`/images/installer-step-${s.n}-dark.${s.dark}.png`}
                    width="1200"
                    height="800"
                    alt={`Aelum installer — ${s.alt}`}
                    loading={s.n === 1 ? "eager" : "lazy"}
                    fetchpriority={s.n === 1 ? "high" : "auto"}
                  />
                  <img
                    class="shot shot--light"
                    src={`/images/installer-step-${s.n}-light.${s.light}.png`}
                    width="1200"
                    height="800"
                    alt={`Aelum installer — ${s.alt}`}
                    loading="lazy"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="section-head install-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf02ca;</span>
          </span>
          The installer
        </span>
        <h2 class="section-title">A few questions. That's it.</h2>
        <p class="section-sub">
          Boot the ISO and answer a few questions in a clean wizard. No terminal
          to touch, no network needed to install.
        </p>
      </div>

      <script type="text/javascript" is:inline>
        // Auto-advancing installer walkthrough, with clickable progress dots.
        (function () {
          var slides = document.querySelectorAll(".slideshow-slide");
          if (!slides.length) return;
          var order = Array.prototype.slice.call(slides);
          var index = 0;
          var timer = null;
          var PAUSE = 3500;

          function show(i) {
            index = (i + order.length) % order.length;
            order.forEach(function (s, n) {
              s.classList.toggle("is-active", n === index);
            });
          }

          function start() {
            stop();
            timer = setInterval(function () {
              show(index + 1);
            }, PAUSE);
          }
          function stop() {
            if (timer) clearInterval(timer);
          }

          var frame = document.querySelector(".features-demo-frame");
          frame.addEventListener("mouseenter", stop);
          frame.addEventListener("mouseleave", start);

          show(0);
          start();
        })();
      </script>
    </div>

    <div class="card-grid grid-steps">
      {
        installSteps.map((step) => (
          <div class="card card-pad-lg card--interactive step-card">
            <span class="step-num" aria-hidden="true">
              {step.num}
            </span>
            <span class="icon-tile" aria-hidden="true">
              <span class="nf-icon">{glyph(step.icon)}</span>
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
