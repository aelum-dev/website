---
import Card from "./Card.astro";
import { installSteps } from "../lib/site";
---

<section class="section">
  <div class="container">
    <div class="install-grid">
      <div class="section-head install-head">
        <span class="eyebrow">The installer</span>
        <h2 class="section-title">A few questions. That's it.</h2>
        <p class="section-sub">
          Just boot the ISO and answer a few questions in a clean wizard. No
          terminal to touch, no network needed to install.
        </p>
      </div>

      <div class="install-visual">
        <div class="features-demo-frame">
          <img
            src="images/installer-screenshot.09bb735a.png"
            width="1125"
            height="750"
            alt="Aelum installer — answering questions and completing installation"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <div class="card-grid grid-steps">
      {installSteps.map((step) => (
        <Card
          title={step.title}
          icon={step.icon}
          description={step.description}
          color="#9b7ff2"
          size="lg"
          className="step-card"
        />
      ))}
    </div>

    <div class="step-cta">
      <div class="card card-pad-lg flex-row between">
        <div class="stack gap-2">
          <h3>ext4 or btrfs?</h3>
          <p>
            Btrfs ships with a sensible automatic subvolume layout — root, home,
            and snapshots are laid out for you. That means automatic CoW
            compression, transparent snapshots, and easy rollbacks, so your
            system stays clean and recoverable out of the box. Pick ext4 only if
            you don't need snapshots or have workloads that btrfs doesn't handle
            well, such as some database setups.
          </p>
        </div>
        <div class="fs-grid">
          <div class="fs-option">
            <span class="card selected-fs"><code>btrfs</code></span>
            <span class="recommended-badge">recommended</span>
          </div>
          <div class="fs-option">
            <span class="card"><code>ext4</code></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
