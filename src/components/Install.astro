---
import Card from "./Card.astro";
import {
  installSteps,
  isoFilename,
  ventoyUrl,
  balenaEtcherUrl,
} from "../lib/site";

const nf = (code: string) =>
  `<span class="nf-icon" aria-hidden="true">${String.fromCodePoint(
    parseInt(code, 16),
  )}</span>`;

const flashTools = [
  {
    icon: "f287", // nerd-fonts: usb
    title: "Ventoy",
    href: ventoyUrl,
    steps: [
      `Download and open Ventoy on your computer.`,
      `Select your USB drive, then click <code>Install</code>.`,
      `Copy <code>{isoFilename}</code> onto the USB drive.`,
      `Boot your computer from that USB drive.`,
    ],
  },
  {
    icon: "f287", // nerd-fonts: usb
    title: "BalenaEtcher",
    href: balenaEtcherUrl,
    steps: [
      `Download and open BalenaEtcher on your computer.`,
      `Choose <code>{isoFilename}</code> as the image to flash.`,
      `Select your USB drive, then click <code>Flash!</code>.`,
      `Boot your computer from that USB drive.`,
    ],
  },
];
---

<section class="section section-no-top">
  <div class="container">
    <div class="reveal flash-wrap">
      <div class="section-head">
        <span class="eyebrow">Before you boot</span>
        <h2 class="section-title">Flash it to a USB drive.</h2>
        <p class="section-sub">
          Either tool writes the ISO to a USB stick in a minute. Ventoy keeps
          the stick usable for other files; BalenaEtcher does a clean,
          single-image flash.
        </p>
      </div>

      <div class="card-grid grid-flash">
        {
          flashTools.map((tool) => (
            <div class="card card-pad-md flash-card">
              <div class="card-title-row">
                <div class="dot" style="--c: #9b7ff2">
                  <span set:html={nf(tool.icon)} />
                </div>
                <h3>{tool.title}</h3>
              </div>
              <ol class="flash-steps">
                {tool.steps.map((step) => (
                  <li set:html={step.replace("{isoFilename}", isoFilename)} />
                ))}
              </ol>
              <a
                class="btn btn-primary"
                href={tool.href}
                target="_blank"
                rel="noopener"
              >
                <span set:html={nf("f0ed")} /> Download {tool.title}
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="install-grid">
      <div class="reveal install-head">
        <span class="eyebrow">The installer</span>
        <h2 class="section-title">A few questions. That's it.</h2>
        <p class="section-sub">
          Just boot the ISO and answer a few questions in a clean wizard. No
          terminal to touch, no network needed to install.
        </p>
      </div>

      <div class="reveal install-visual">
        <div class="features-demo-frame">
          <video
            src="images/installer-demo.38dd6a0b.mp4"
            width="1280"
            height="720"
            aria-label="Aelum installer walkthrough — answering questions and completing installation"
            autoplay
            muted
            loop
            playsinline></video>
        </div>
      </div>
    </div>

    <div class="card-grid grid-steps">
      {
        installSteps.map((step) => (
          <Card
            title={step.title}
            icon={step.icon}
            description={step.description}
            color="#9b7ff2"
            size="lg"
            className="step-card"
          />
        ))
      }
    </div>

    <div class="reveal step-cta">
      <div class="card card-pad-lg flex-row between">
        <div class="stack gap-2" style="align-items:flex-start;">
          <h3>Ext4 or Btrfs?</h3>
          <p>
            BTRFS ships with a sensible automatic subvolume layout — root, home,
            and snapshots are laid out for you. That means automatic CoW
            compression, transparent snapshots, and easy rollbacks, so your
            system stays clean and recoverable out of the box. Pick ext4 only if
            you don't need snapshots or have workloads that BTRFS doesn't handle
            well, such as some database setups.
          </p>
        </div>
        <div class="fs-grid">
          <div class="fs-option">
            <span class="card selected-fs"><code>btrfs</code></span>
            <span class="recommended-badge">recommended</span>
          </div>
          <div class="fs-option">
            <span class="card"><code>ext4</code></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
