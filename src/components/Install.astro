---
import { installSteps } from "../lib/site";
import Card from "./Card.astro";
---

<section class="section">
  <div class="container">
    <div class="install-grid">
      <div class="section-head install-head">
        <span class="eyebrow">The installer</span>
        <h2 class="section-title">A few questions. That's it.</h2>
        <p class="section-sub">
          Just boot the ISO and answer a few questions in a clean wizard. No
          terminal to touch, no network needed to install.
        </p>
      </div>

      <div class="install-visual">
        <div class="features-demo-frame">
          <div class="slideshow" role="group" aria-label="Aelum installer walkthrough">
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-1-dark.34a7ac07.png"
                width="1200"
                height="800"
                alt="Aelum installer — language selection"
                loading="eager"
                fetchpriority="high"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-1-light.c5ed937e.png"
                width="1200"
                height="800"
                alt="Aelum installer — language selection"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-2-dark.bc4bc0ad.png"
                width="1200"
                height="800"
                alt="Aelum installer — creating the user account"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-2-light.ce77cab9.png"
                width="1200"
                height="800"
                alt="Aelum installer — creating the user account"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-3-dark.bc5f612e.png"
                width="1200"
                height="800"
                alt="Aelum installer — selecting a disk"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-3-light.499e45a6.png"
                width="1200"
                height="800"
                alt="Aelum installer — selecting a disk"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-4-dark.f3644a3e.png"
                width="1200"
                height="800"
                alt="Aelum installer — partitioning the disk"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-4-light.00beb481.png"
                width="1200"
                height="800"
                alt="Aelum installer — partitioning the disk"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-5-dark.3d1e3e63.png"
                width="1200"
                height="800"
                alt="Aelum installer — confirming installation"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-5-light.45360f27.png"
                width="1200"
                height="800"
                alt="Aelum installer — confirming installation"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-6-dark.9184b61d.png"
                width="1200"
                height="800"
                alt="Aelum installer — installing the system"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-6-light.3ffdd65a.png"
                width="1200"
                height="800"
                alt="Aelum installer — installing the system"
              />
            </div>
            <div class="slideshow-slide">
              <img
                class="shot shot--dark"
                src="images/installer-step-7-dark.9146d8e2.png"
                width="1200"
                height="800"
                alt="Aelum installer — installation complete"
              />
              <img
                class="shot shot--light"
                src="images/installer-step-7-light.bc065e84.png"
                width="1200"
                height="800"
                alt="Aelum installer — installation complete"
              />
            </div>
          </div>
        </div>
      </div>

      <script type="text/javascript" is:inline>
        // Auto-advancing installer walkthrough. Runs after parse (inline scripts
        // are modules/deferred); guard anyway so it's safe if markup moves.
        (function () {
          var slides = document.querySelectorAll(".slideshow-slide");
          if (!slides.length) return;
          var order = Array.prototype.slice.call(slides);
          var index = 0;
          var timer = null;
          var PAUSE = 3500;

          function show(i) {
            index = (i + order.length) % order.length;
            order.forEach(function (s, n) {
              s.classList.toggle("is-active", n === index);
            });
          }

          function tick() {
            show(index + 1);
          }

          function start() {
            stop();
            timer = setInterval(tick, PAUSE);
          }

          function stop() {
            if (timer) clearInterval(timer);
          }

          var group = order[0].parentElement;
          group.addEventListener("mouseenter", stop);
          group.addEventListener("mouseleave", start);

          show(0);
          start();
        })();
      </script>
    </div>

    <div class="card-grid grid-steps">
      {installSteps.map((step) => (
        <Card
          title={step.title}
          icon={step.icon}
          description={step.description}
          color="#9b7ff2"
          size="lg"
          className="step-card"
        />
      ))}
    </div>

  </div>
</section>
