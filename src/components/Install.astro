---
import { installSteps } from "../lib/site";
import Shot from "./Shot.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

const slides = [
  { n: 1, alt: "language selection" },
  { n: 2, alt: "creating the user account" },
  { n: 3, alt: "selecting a disk" },
  { n: 4, alt: "partitioning the disk" },
  { n: 5, alt: "confirming installation" },
  { n: 6, alt: "installing the system" },
  { n: 7, alt: "installation complete" },
];
---

<section class="section">
  <div class="container">
    <div class="install-grid">
      <div class="install-visual reveal">
        <div class="features-demo-frame">
          <span class="frame-ring" aria-hidden="true"></span>
          <div
            class="slideshow"
            role="group"
            aria-label="Aelum installer walkthrough"
          >
            {
              slides.map((s) => (
                <div class="slideshow-slide">
                  <Shot
                    light={`installer-step-${s.n}-light`}
                    dark={`installer-step-${s.n}-dark`}
                    alt={`Aelum installer — ${s.alt}`}
                    sizes="(max-width: 620px) 100vw, 620px"
                    eager={s.n === 1}
                    class="shot"
                  />
                </div>
              ))
            }
          </div>
          <!-- One segment per slide; the active one fills as the pause runs out.
            Decorative: the walkthrough itself is announced by the group above. -->
          <span class="frame-progress" aria-hidden="true">
            {slides.map(() => <span class="frame-seg"></span>)}
          </span>
        </div>
      </div>

      <div class="section-head install-head reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf02ca;</span>
          </span>
          The installer
        </span>
        <h2 class="section-title">A few questions. That's it.</h2>
        <p class="section-sub">
          Boot the ISO and answer a few questions in a clean wizard. No terminal
          to touch, no network needed to install.
        </p>
      </div>

      <script type="text/javascript" is:inline>
        // Auto-advancing installer walkthrough.
        //
        // The slides are all in the document (every one of them is a real
        // <picture>), so with JavaScript off the first slide simply stays put
        // and the progress bar is empty. JS only moves which one you see.
        //
        // It stops when the frame is not on screen. install.css pauses the
        // segment fill animation inside any section app.js has not marked
        // .is-live (see base.css → Off-screen loops); a timer that kept
        // advancing while its own progress bar was paused would walk out of step
        // with it, and the frame would resume mid-slide.
        (function () {
          var slides = document.querySelectorAll(".slideshow-slide");
          if (!slides.length) return;
          var order = Array.prototype.slice.call(slides);
          var segments = Array.prototype.slice.call(
            document.querySelectorAll(".frame-seg"),
          );
          var frame = document.querySelector(".features-demo-frame");
          var index = 0;
          var timer = null;
          var PAUSE = 3500;
          var hovered = false;
          var onScreen = true;
          var tracked = false;

          function show(i) {
            index = (i + order.length) % order.length;
            order.forEach(function (s, n) {
              s.classList.toggle("is-active", n === index);
            });
            segments.forEach(function (seg, n) {
              seg.classList.toggle("is-active", n === index);
              // Restart the fill animation on the newly active segment.
              if (n === index) {
                seg.style.animation = "none";
                void seg.offsetWidth;
                seg.style.animation = "";
              }
            });
          }

          function start() {
            if (timer) return;
            timer = setInterval(function () {
              show(index + 1);
            }, PAUSE);
          }

          function stop() {
            if (!timer) return;
            clearInterval(timer);
            timer = null;
          }

          // Hovering the walkthrough is a request to look at it; being off screen
          // is the same request from the viewport.
          function sync() {
            if (hovered || (tracked && !onScreen)) stop();
            else start();
          }

          frame.addEventListener("mouseenter", function () {
            hovered = true;
            sync();
          });
          frame.addEventListener("mouseleave", function () {
            hovered = false;
            sync();
          });

          show(0);

          if (!("IntersectionObserver" in window)) {
            start();
            return;
          }

          var io = new IntersectionObserver(
            function (entries) {
              onScreen = entries[entries.length - 1].isIntersecting;
              tracked = true;
              sync();
            },
            { rootMargin: "200px 0px 200px 0px", threshold: 0 },
          );
          io.observe(frame);
        })();
      </script>
    </div>

    <div class="card-grid grid-steps">
      {
        installSteps.map((step) => (
          <div class="card card-pad-lg card--interactive step-card">
            <span class="step-num" aria-hidden="true">
              {step.num}
            </span>
            <span class="icon-tile" aria-hidden="true">
              <span class="nf-icon">{glyph(step.icon)}</span>
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
