---
import { ghRepo } from "../lib/site";
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#top">
      <span class="glyph"
        ><img
          src="favicon-32.png"
          alt="AestheticOS logo"
          width="34"
          height="34"
          loading="eager"
        /></span
      >
      <span class="hero-brand">AestheticOS</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="hide-mobile" href="#desktop">Desktop</a>
      <a class="hide-mobile" href="#install">Install</a>
      <a class="hide-mobile" href="#languages">Languages</a>
      <a class="hide-mobile" href="#cli">CLI</a>
      <a class="hide-mobile" href="#features">Features</a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle="switch"
        aria-label="Toggle dark and light mode"
        title="Toggle dark and light mode"
      >
        <span
          class="theme-toggle-icon"
          data-theme-icon="dark"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
          >
        </span>
        <span
          class="theme-toggle-icon"
          data-theme-icon="light"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v24-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </span>
      </button>
      <a
        class="btn btn-ghost nav-gh"
        href={ghRepo}
        target="_blank"
        rel="noopener"
        ><span class="nf-icon" aria-hidden="true">&#xf09b;</span> GitHub</a
      >
    </nav>
  </div>
</header>
