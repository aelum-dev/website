---
import { gitlabUrl } from "../lib/site";
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="#home" data-page="home">
      <span class="glyph">
        <img
          src="logo.svg"
          alt="Aelum logo"
          width="30"
          height="27"
          loading="eager"
        />
      </span>
      <span class="hero-brand">Aelum</span>
    </a>

    <nav class="nav-links" id="nav-menu" data-nav-menu aria-label="Primary">
      <a class="active" href="#home" data-page="home">Home</a>
      <a href="#download" data-page="download">Download</a>
      <a href="#install" data-page="install">Install</a>
      <a href="#features" data-page="features">Features</a>
    </nav>

    <div class="nav-actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle="switch"
        aria-pressed="false"
        aria-label="Toggle dark and light mode"
        title="Toggle dark and light mode"
      >
        <span
          class="theme-toggle-icon"
          data-theme-icon="dark"
          aria-hidden="true"
          title="Switch to light mode"
        >
          <span class="nf-icon">&#xf0594;</span>
        </span>
        <span
          class="theme-toggle-icon"
          data-theme-icon="light"
          aria-hidden="true"
          title="Switch to dark mode"
        >
          <span class="nf-icon">&#xf522;</span>
        </span>
      </button>
      <a
        class="btn btn-ghost nav-gl"
        href={gitlabUrl}
        target="_blank"
        rel="noopener"
      >
        <span class="nf-icon" aria-hidden="true">&#xf296;</span> GitLab
      </a>
      <button
        type="button"
        class="nav-burger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>
