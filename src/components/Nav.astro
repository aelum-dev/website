---
import { githubUrl, navLinks, type PageId } from "../lib/site";

interface Props {
  /** The page being rendered; marks the matching link server-side so the
    active state is correct with JavaScript off. */
  active: PageId;
}

const { active } = Astro.props;

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="/" aria-current={active === "home" ? "page" : undefined}>
      <span class="glyph">
        <img
          src="/logo.svg"
          alt="Aelum logo"
          width="30"
          height="27"
          loading="eager"
        />
      </span>
      <span class="hero-brand">Aelum</span>
    </a>

    <nav class="nav-links" id="nav-menu" data-nav-menu aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            class={link.id === active ? "active" : undefined}
            href={link.href}
            aria-current={link.id === active ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle="switch"
        aria-pressed="false"
        aria-label="Toggle dark and light mode"
        title="Toggle dark and light mode"
      >
        <span
          class="theme-toggle-icon"
          data-theme-icon="dark"
          aria-hidden="true"
          title="Switch to light mode"
        >
          <span class="nf-icon">{glyph("f0594")}</span>
        </span>
        <span
          class="theme-toggle-icon"
          data-theme-icon="light"
          aria-hidden="true"
          title="Switch to dark mode"
        >
          <span class="nf-icon">{glyph("f522")}</span>
        </span>
      </button>
      <a class="btn btn-ghost nav-gl" href={githubUrl} target="_blank" rel="noopener">
        <span class="nf-icon" aria-hidden="true">{glyph("f09b")}</span>
        GitHub
      </a>
      <button
        type="button"
        class="nav-burger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>
