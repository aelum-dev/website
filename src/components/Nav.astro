---
import { installerRepo } from "../lib/site";
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="./">
      <span class="glyph"
        ><img
          src="favicon-32.png"
          alt="AestheticOS logo"
          width="34"
          height="34"
          loading="eager"
        /></span
      >
      <span class="hero-brand">AestheticOS</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="hide-mobile" href="#desktop">Desktop</a>
      <a class="hide-mobile" href="#install">Install</a>
      <a class="hide-mobile" href="#features">Features</a>
      <a class="hide-mobile" href="#languages">Languages</a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle="switch"
        aria-label="Toggle dark and light mode"
        title="Toggle dark and light mode"
      >
        <span
          class="theme-toggle-icon"
          data-theme-icon="dark"
          aria-hidden="true"
          title="Switch to light mode"
        >
          <span class="nf-icon">&#xfa93;</span>
        </span>
        <span
          class="theme-toggle-icon"
          data-theme-icon="light"
          aria-hidden="true"
          title="Switch to dark mode"
        >
          <span class="nf-icon">&#xf185;</span>
        </span>
      </button>
      <a
        class="btn btn-ghost nav-gh"
        href={installerRepo}
        target="_blank"
        rel="noopener"
        ><span class="nf-icon" aria-hidden="true">&#xf09b;</span> GitHub</a
      >
    </nav>
  </div>
</header>
