---
import { showcase } from "../lib/site";
import Shot from "./Shot.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));
---

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">{glyph("f0570")}</span>
        </span>
        What lands on disk
      </span>
      <h2 class="section-title">One ISO. No downloads.</h2>
      <p class="section-sub">
        The ISO carries the live session and every package the install needs.
        What it writes is a themed Arch desktop with a login screen — not a base
        install you have to finish yourself.
      </p>
    </div>

    <div class="bento" data-stagger>
      {
        showcase.map((tile) => {
          if (tile.kind === "shot") {
            return (
              <figure class={`bento-tile bento-shot reveal${tile.span === "wide" ? " bento-wide" : ""}`}>
                <div class="bento-shot-inner">
                  <Shot
                    light={tile.light}
                    dark={tile.dark}
                    alt={tile.alt}
                    sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 620px"
                  />
                </div>
                <figcaption class="bento-caption">{tile.caption}</figcaption>
              </figure>
            );
          }

          if (tile.kind === "stat") {
            return (
              <div class="bento-tile bento-stat card card-pad-md reveal">
                <span class="bento-value nums" data-count={tile.value} data-decimals="0">
                  {tile.value}
                </span>
                <span class="bento-unit">{tile.unit}</span>
                <h3>{tile.label}</h3>
                <p>{tile.note}</p>
              </div>
            );
          }

          return (
            <div class="bento-tile bento-feature card card-pad-md card--interactive reveal">
              <span class="icon-tile" aria-hidden="true">
                <span class="nf-icon">{glyph(tile.icon)}</span>
              </span>
              <h3>{tile.title}</h3>
              <p>{tile.description}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
