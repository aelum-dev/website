---
import { software, wallpaperSettingsShot } from "../lib/site";
import Card from "./Card.astro";
import Shot from "./Shot.astro";
---

<section id="desktop" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf108;</span>
        </span>
        On the desktop
      </span>
      <h2 class="section-title">What you get installed</h2>
      <p class="section-sub">
        The desktop is set up before you log in for the first time: Hyprland
        with Dux Shell, a greeter that matches it, and GTK and Qt colors that
        matugen takes from your wallpaper. There is no theming left for you to
        do.
      </p>
    </div>

    <figure class="look-shot desktop-demo reveal">
      <div class="look-shot-inner">
        <Shot
          light={wallpaperSettingsShot.light}
          dark={wallpaperSettingsShot.dark}
          alt={wallpaperSettingsShot.alt}
          sizes="(max-width: 1160px) 92vw, 1100px"
        />
      </div>
      <figcaption class="look-caption">{wallpaperSettingsShot.caption}</figcaption>
    </figure>

    <div class="card-grid grid-software">
      {
        software.map((app) => (
          <Card
            icon={app.icon}
            title={app.title}
            description={app.description}
            size="md"
            className="tile-software"
          />
        ))
      }
    </div>
  </div>
</section>
