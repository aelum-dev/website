---
import { software } from "../lib/site";
import Card from "./Card.astro";
---

<section id="desktop" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf108;</span>
        </span>
        What you install
      </span>
      <h2 class="section-title">What ships installed</h2>
      <p class="section-sub">
        The installer writes a themed desktop: Hyprland with DankMaterialShell, a
        greeter that matches it, and GTK and Qt colours generated from your
        wallpaper by matugen. There is no theming pass to do afterwards.
      </p>
    </div>

    <div class="card-grid grid-software">
      {
        software.map((app) => (
          <Card
            icon={app.icon}
            title={app.title}
            description={app.description}
            size="md"
            className="tile-software"
          />
        ))
      }
    </div>
  </div>
</section>
