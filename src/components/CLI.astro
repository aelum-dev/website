---

---

<section id="cli" class="section section-no-top">
  <div class="container">
    <div class="reveal section-head">
      <div class="cli-card">
        <div class="cli-titlebar">
          <span class="cli-dot cli-dot-r"></span>
          <span class="cli-dot cli-dot-y"></span>
          <span class="cli-dot cli-dot-g"></span>
          <span class="cli-title">aelum-installer-cli</span>
        </div>
        <pre
          class="cli-code"><code><span style="color:var(--accent-green)"># GUI</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli

<span style="color:var(--accent-green)"># CLI — full install</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli <span style="color:var(--accent-2)">--install /dev/vda</span>

<span style="color:var(--accent-green)"># CLI — btrfs root instead of ext4</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli <span style="color:var(--accent-2)">--install /dev/vda --filesystem btrfs</span></code></pre>
      </div>
      <p class="cli-note">
        Prefer headless or scripted installs? The live ISO also ships a CLI.
      </p>
    </div>
  </div>
</section>
