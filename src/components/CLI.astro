---
import CopyButton from "./CopyButton.astro";
---

<section id="cli" class="section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf120;</span>
        </span>
        Headless installs
      </span>
      <h2 class="section-title">Installing from the terminal</h2>
      <p class="section-sub">
        If you would rather script the install, the live ISO ships a command line
        version next to the GUI. It runs the same eight install steps, so you end
        up with the same system.
      </p>
    </div>

    <div class="cli-card card reveal">
      <div class="cli-titlebar">
        <span class="cli-dot cli-dot-r"></span>
        <span class="cli-dot cli-dot-y"></span>
        <span class="cli-dot cli-dot-g"></span>
        <span class="cli-title">aelum-installer-cli</span>
        <CopyButton
          target="#cli-code"
          label="Copy commands"
          className="cli-copy"
        />
      </div>
      <pre
        class="cli-code"
        id="cli-code"><code><span style="color:var(--accent-green)"># GUI</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer

<span style="color:var(--accent-green)"># CLI — full install</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli <span style="color:var(--accent-2)">--install /dev/vda</span>

<span style="color:var(--accent-green)"># CLI — ext4 root instead of the default btrfs</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli <span style="color:var(--accent-2)">--install /dev/vda --filesystem ext4</span>

<span style="color:var(--accent-green)"># LUKS2 + LVM. Passwords are read from stdin, never from a flag</span>
<span style="color:var(--accent-3)">sudo</span> /usr/local/bin/aelum-installer-cli <span style="color:var(--accent-2)">--install /dev/vda --luks --lvm</span></code></pre>
    </div>
  </div>
</section>
