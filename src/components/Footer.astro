---
import {
  dockerRepo,
  duxShellUrl,
  githubUrl,
  goUrl,
  hyprlandUrl,
  installerRepo,
  mainRepo,
  navLinks,
  wailsUrl,
} from "../lib/site";
---

<footer class="footer">
  <div class="container">
    <span class="footer-mark" aria-hidden="true">Aelum</span>
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span class="glyph">
            <img src="/logo.svg" alt="Aelum logo" width="32" height="29" />
          </span>
          <span class="hero-brand">Aelum</span>
        </a>
        <p>
          An Arch Linux distro whose installer works without internet. Boot the
          ISO, answer four questions, and you have a Hyprland + Dux Shell
          desktop.
        </p>
      </div>

      <div class="footer-col">
        <h4>Site</h4>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h4>Project</h4>
        <ul>
          <li>
            <a href={mainRepo} target="_blank" rel="noopener">Live-ISO</a>
          </li>
          <li>
            <a href={installerRepo} target="_blank" rel="noopener">Installer</a>
          </li>
          <li>
            <a href={dockerRepo} target="_blank" rel="noopener">Docker</a>
          </li>
          <li><a href={githubUrl} target="_blank" rel="noopener">GitHub</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Built with</h4>
        <ul>
          <li>
            <a href={hyprlandUrl} target="_blank" rel="noopener">Hyprland</a>
          </li>
          <li>
            <a href={duxShellUrl} target="_blank" rel="noopener">
              Dux Shell
            </a>
          </li>
          <li><a href={wailsUrl} target="_blank" rel="noopener">Wails v2</a></li>
          <li><a href={goUrl} target="_blank" rel="noopener">Go</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>GPL-3.0 · © Aelum</span>
    </div>
  </div>
</footer>
