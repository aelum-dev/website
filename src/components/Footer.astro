---
import {
  mainRepo,
  installerRepo,
  hyprlandUrl,
  dmsUrl,
  wailsUrl,
} from "../lib/site";
---

<footer class="footer">
  <div class="container footer-row">
    <div class="flex items-center gap-3 footer-brand">
      <span class="glyph footer-glyph"
        ><img
          src="favicon-32.png"
          alt="AestheticOS logo"
          width="28"
          height="28"
        /></span
      >
      <span class="hero-brand">AestheticOS</span>
    </div>
    <div class="flex flex-wrap items-center gap-6 footer-links">
      <a href={mainRepo} target="_blank" rel="noopener">AestheticOS</a>
      <a href={installerRepo} target="_blank" rel="noopener">Installer</a>
      <a href={hyprlandUrl} target="_blank" rel="noopener">Hyprland</a>
      <a href={dmsUrl} target="_blank" rel="noopener">DankMaterialShell</a>
      <a href={wailsUrl} target="_blank" rel="noopener">Wails v2</a>
    </div>
    <div>GPL-3.0</div>
  </div>
</footer>
