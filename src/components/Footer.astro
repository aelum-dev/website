---
import Star from './Star.astro';
import { isoRepo, ghRepo, hyprlandUrl, wailsUrl } from '../lib/site';
---

<footer class="footer">
  <div class="container footer-row">
    <div class="flex items-center gap-3 footer-brand">
      <span class="glyph footer-glyph"><Star size={15} /></span>
      <span>AestheticOS</span>
    </div>
    <div class="flex flex-wrap items-center gap-6 footer-links">
      <a href={isoRepo} target="_blank" rel="noopener">AestheticOS (ISO)</a>
      <a href={ghRepo} target="_blank" rel="noopener">AestheticOS Installer</a>
      <a href={hyprlandUrl} target="_blank" rel="noopener">Hyprland</a>
      <a href={wailsUrl} target="_blank" rel="noopener">Wails v2</a>
    </div>
    <div>GPL-3.0</div>
  </div>
</footer>
