---
// Reusable glassy card. Optional colored icon slot keeps feature cards DRY.

interface Props {
  title?: string;
  description?: string;
  color?: string;
  icon?: string;
  badge?: string;
  size?: "md" | "lg";
  className?: string;
}

const {
  title = undefined,
  description = undefined,
  color = undefined,
  icon = undefined,
  badge = undefined,
  size = "lg",
  className = "",
} = Astro.props;
---

<div class={"card card-pad-" + size + (className ? " " + className : "")}>
  {
    color && title && (
      <div class="card-title-row">
        {badge && <span class="card-badge">{badge}</span>}
        <div class="dot" style="--c:{color}">
          {icon ? (
            <span class="nf-icon" aria-hidden="true">
              {String.fromCodePoint(parseInt(icon, 16))}
            </span>
          ) : (
            <span aria-hidden="true">●</span>
          )}
        </div>
        <h3>{title}</h3>
      </div>
    )
  }
  {title && !color && <h3>{title}</h3>}
  {description && <p>{description}</p>}
  <slot />
</div>
