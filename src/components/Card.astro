---
// Reusable glassy card. Optional colored icon slot keeps feature cards DRY.
import Star from "./Star.astro";

interface Props {
  title?: string;
  description?: string;
  color?: string;
  icon?: string;
  size?: "md" | "lg";
  className?: string;
}

const {
  title = undefined,
  description = undefined,
  color = undefined,
  icon = undefined,
  size = "lg",
  className = "",
} = Astro.props;
---

<div class={"card card-pad-" + size + (className ? " " + className : "")}>
  {
    color && title && (
      <div class="card-title-row">
        <div class="dot" style="--c:{color}">
          {
            icon ? (
              <span class="nf-icon" aria-hidden="true">
                {String.fromCodePoint(parseInt(icon, 16))}
              </span>
            ) : (
              <Star size={18} />
            )
          }
        </div>
        <slot name="top" />
        <h3>{title}</h3>
      </div>
    )
  }
  {description && <p>{description}</p>}
  <slot />
</div>
