---
// Reusable glassy card. Optional colored icon + badge keep feature cards DRY.

interface Props {
  title?: string;
  description?: string;
  color?: string;
  icon?: string;
  badge?: string;
  size?: "md" | "lg";
  className?: string;
}

const {
  title = undefined,
  description = undefined,
  color = "var(--accent)",
  icon = undefined,
  badge = undefined,
  size = "lg",
  className = "",
} = Astro.props;

const glyph = icon ? String.fromCodePoint(parseInt(icon, 16)) : null;
const classes = ["card", `card-pad-${size}`, "card--interactive", className].filter(Boolean).join(" ");
---

<div class={classes}>
  {
    title && (
      <div class="card-head">
        {icon && (
          <span class="icon-tile" style={`--c:${color}`} aria-hidden="true">
            <span class="nf-icon">{glyph}</span>
          </span>
        )}
        <div class="card-head-text">
          {badge && (
            <span class="card-badge" style={`--c:${color}`}>
              {badge}
            </span>
          )}
          <h3>{title}</h3>
        </div>
      </div>
    )
  }
  {description && <p>{description}</p>}
  <slot />
</div>
