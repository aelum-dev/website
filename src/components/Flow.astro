---
import { flow } from "../lib/site";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));
---

<section class="section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">{glyph("f046a")}</span>
        </span>
        How the install goes
      </span>
      <h2 class="section-title">From USB stick to desktop in three steps</h2>
      <p class="section-sub">
        In automatic mode there's nothing to plan: no partitions to lay out, no
        mirrors to pick. The desktop is already themed when you log in. Want to
        keep another OS on the disk? Switch the disk screen to manual mode and
        pick the two partitions. Everything else is left alone.
      </p>
    </div>

    <ol class="flow" data-stagger>
      <span class="flow-line" aria-hidden="true"></span>
      {
        flow.map((step) => (
          <li class="flow-step reveal">
            <span class="step-num nums">{step.num}</span>
            <span class="icon-tile" style="--c:var(--accent)" aria-hidden="true">
              <span class="nf-icon">{glyph(step.icon)}</span>
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
