---
import { flow } from "../lib/site";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));
---

<section class="section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">{glyph("f046a")}</span>
        </span>
        How the install goes
      </span>
      <h2 class="section-title">Three steps from a USB stick to a desktop</h2>
      <p class="section-sub">
        In automatic mode there is no partition layout to plan and no mirror to
        configure, and the desktop gets its colors while it installs. If you
        want to keep another operating system on the disk, switch the disk
        screen to manual mode and choose the partitions yourself.
      </p>
    </div>

    <ol class="flow" data-stagger>
      <span class="flow-line" aria-hidden="true"></span>
      {
        flow.map((step) => (
          <li class="flow-step reveal">
            <span class="step-num nums">{step.num}</span>
            <span class="icon-tile" style="--c:var(--accent)" aria-hidden="true">
              <span class="nf-icon">{glyph(step.icon)}</span>
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
