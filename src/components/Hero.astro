---
import Star from "./Star.astro";
---

<section class="section hero-pad">
  <div class="container">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow"
          ><Star size={12} /> Fully offline · No internet required</span
        >
        <h1 class="section-title hero-title">
          A beautiful <span class="text-gradient">offline</span> Arch-based distro.
        </h1>
        <p class="hero-lead">
          Boot the ISO. The installer starts on its own. <br /> You finish with a
          polished Hyprland desktop with a DankMaterialShell — no terminal, no network.
        </p>
        <div class="flex gap-4 hero-actions">
          <slot name="actions" />
        </div>

        <dl class="hero-stats">
          <div class="stat">
            <dt>Install time</dt>
            <dd>~1<span>min</span></dd>
          </div>
          <div class="stat">
            <dt>Installed size</dt>
            <dd>4.7<span>GB</span></dd>
          </div>
          <div class="stat">
            <dt>Network needed</dt>
            <dd class="stat-green">Never</dd>
          </div>
        </dl>
      </div>

      <div class="reveal reveal-hero-visual" aria-hidden="true">
        <div class="hero-visual">
          <div class="hero-shot hero-shot--dark">
            <img
              src="images/hero-dark.png"
              width="2560"
              height="1440"
              alt="AestheticOS desktop terminal in dark theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hero-shot hero-shot--light">
            <img
              src="images/hero-light.png"
              width="2560"
              height="1440"
              alt="AestheticOS desktop terminal in light theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
