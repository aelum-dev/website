---
import { controlCenterShot } from "../lib/site";
import Shot from "./Shot.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

const points = [
  { icon: "f05aa", label: "Offline installer — every package comes from the USB stick" },
  {
    icon: "f03d8",
    label: "Colors of the whole desktop and apps are set by your wallpaper",
  },
  { icon: "f02da", label: "Easy rollbacks to a previous state" },
  { icon: "f012c", label: "ISO is signed, and its checksums are published" },
];

// Headline lines. Each one is masked and rises into place on load (see
// home.css → hero-title): with JavaScript off the `js` class is never added and
// the lines are simply there.
const lines = [
  { text: "Arch power", accent: false },
  { text: "with material elegance", accent: true },
];

// The four numbers a first-time visitor actually compares. "Install time"
// states the ceiling the end-to-end span measured in this project's own QEMU
// install matrix stays under (docker/logs/matrix → first step to "Installation
// completed successfully"); "Installed size" states the ceiling a btrfs
// install stays under (the FAQ keeps the exact figure); "RAM usage" is what the
// running desktop holds in memory — no harness in these repos measures it, so
// re-check it against a booted install before changing it. "Languages" is the
// desktop shell's translation count; the installer's own UI languages (28)
// are listed on /install/#languages. The count-up reads the decimal places
// straight out of the string so "3.2" never renders as "3.20".
const stats = [
  { dt: "Install time", value: "2", prefix: "<", unit: "min" },
  { dt: "Installed size", value: "4", prefix: "<", unit: "GB" },
  { dt: "RAM usage", value: "1", prefix: "<", unit: "GB" },
  { dt: "Languages", value: "23" },
];
---

<section class="section hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">{glyph("f0ed")}</span>
          </span>
          Beautiful out of the box
        </span>

        <h1 class="hero-title">
          {
            lines.map((line) => (
              <span class="hero-line">
                <span class={line.accent ? "hero-accent" : undefined}>{line.text}</span>
              </span>
            ))
          }
        </h1>

        <p class="hero-lead">
          An Arch-based distro with a fully offline installer, focused on
          stability, beauty and speed.
        </p>

        <div class="hero-actions">
          <slot name="actions" />
        </div>

        <ul class="hero-points">
          {
            points.map((p) => (
              <li>
                <span class="nf-icon" aria-hidden="true">
                  {glyph(p.icon)}
                </span>
                {p.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-visual-wrap reveal" aria-hidden="true">
        <span class="hero-halo"></span>
        <div class="hero-visual" data-tilt>
          <span class="hero-ring"></span>
          <div class="hero-frame">
            <Shot
              light={controlCenterShot.light}
              dark={controlCenterShot.dark}
              alt={controlCenterShot.alt}
              sizes="(max-width: 640px) 100vw, 640px"
              eager={true}
            />
          </div>
          <span class="hero-sheen"></span>
        </div>
      </div>
    </div>

    <dl class="hero-stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.dt}</dt>
            <dd>
              <span
                class="stat-num nums"
                data-count={s.value}
                data-decimals={(s.value.split(".")[1] ?? "").length}
              >
                {s.prefix ?? ""}
                {s.value}
              </span>
              {s.unit && <span class="stat-unit">{s.unit}</span>}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll-line"></span>
      <span class="hero-scroll-label">Scroll down</span>
    </div>
  </div>
</section>
