---
import Star from "./Star.astro";
---

<section class="section hero-pad">
  <div class="container">
    <div class="hero-grid">
      <div class="reveal hero-title-wrap">
        <h1 class="section-title hero-title">
          <span class="text-gradient">Arch-based</span> distro with theming.
        </h1>
      </div>

      <div class="reveal reveal-hero-visual" aria-hidden="true">
        <div class="hero-visual">
          <div class="hero-shot hero-shot--dark">
            <img
              src="images/hero-dark.f72b5dd8.png"
              width="2560"
              height="1440"
              alt="AestheticOS desktop terminal in dark theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hero-shot hero-shot--light">
            <img
              src="images/hero-light.49795993.png"
              width="2560"
              height="1440"
              alt="AestheticOS desktop terminal in light theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="reveal hero-below">
        <span class="eyebrow"
          ><Star size={12} /> Fully offline installer · No internet required to install</span
        >
        <p class="hero-lead">
          A Hyprland desktop with DankMaterialShell, plus Qt/GTK theming set up
          for you.
        </p>
        <div class="flex gap-4 hero-actions">
          <slot name="actions" />
        </div>

        <dl class="hero-stats">
          <div class="stat">
            <dt>Install time</dt>
            <dd>~1<span>min</span></dd>
          </div>
          <div class="stat">
            <dt>Installed size</dt>
            <dd>4.7<span>GB</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
