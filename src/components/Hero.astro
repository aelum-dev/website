---
import { languages } from "../lib/site";
import Shot from "./Shot.astro";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));

const points = [
  { icon: "f05aa", label: "No internet needed to install" },
  { icon: "f012c", label: "Verified, signed release" },
];

// Headline lines. Each one is masked and rises into place on load (see
// home.css → hero-title): with JavaScript off the `js` class is never added and
// the lines are simply there.
const lines = [
  { text: "Arch power.", accent: false },
  { text: "Material elegance.", accent: true },
];

// The three numbers a first-time visitor actually compares. "Installed size" is
// the btrfs figure the Features page states; the count-up reads the decimal
// places straight out of the string so "3.2" never renders as "3.20".
const stats = [
  { dt: "Install time", value: "1", prefix: "~", unit: "min" },
  { dt: "Installed size", value: "3.2", unit: "GB" },
  { dt: "Languages", value: String(languages.length) },
];
---

<section class="section hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">{glyph("f0ed")}</span>
          </span>
          Fully offline installer
        </span>

        <h1 class="hero-title">
          {
            lines.map((line) => (
              <span class="hero-line">
                <span class={line.accent ? "hero-accent" : undefined}>{line.text}</span>
              </span>
            ))
          }
        </h1>

        <p class="hero-lead">
          Boots into a barebones Hyprland session that just runs the installer.
          Answer a few questions and you get a finished Hyprland +
          DankMaterialShell desktop — no internet needed.
        </p>

        <div class="hero-actions">
          <slot name="actions" />
        </div>

        <ul class="hero-points">
          {
            points.map((p) => (
              <li>
                <span class="nf-icon" aria-hidden="true">
                  {glyph(p.icon)}
                </span>
                {p.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-visual-wrap reveal" aria-hidden="true">
        <span class="hero-halo"></span>
        <div class="hero-visual" data-tilt>
          <span class="hero-ring"></span>
          <div class="hero-frame">
            <Shot
              light="hero-light"
              dark="hero-dark"
              alt="Aelum fastfetch output on the Aelum desktop"
              sizes="(max-width: 640px) 100vw, 640px"
              eager={true}
            />
          </div>
          <span class="hero-sheen"></span>
        </div>
        <div class="hero-chip hero-chip--tl">
          <span class="nf-icon">{glyph("f0570")}</span> Tiling by Hyprland
        </div>
        <div class="hero-chip hero-chip--br">
          <span class="nf-icon">{glyph("f0342")}</span> DankMaterialShell
        </div>
      </div>
    </div>

    <dl class="hero-stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.dt}</dt>
            <dd>
              <span
                class="stat-num nums"
                data-count={s.value}
                data-decimals={(s.value.split(".")[1] ?? "").length}
              >
                {s.prefix ?? ""}
                {s.value}
              </span>
              {s.unit && <span class="stat-unit">{s.unit}</span>}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll-line"></span>
      <span class="hero-scroll-label">Keep going</span>
    </div>
  </div>
</section>
