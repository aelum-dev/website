---
import { languages } from "../lib/site";

const points = [
  { icon: "f05aa", label: "No internet needed to install" },
  { icon: "f012c", label: "Verified, signed release" },
];
---

<section class="section hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <span class="eyebrow">
          <span class="eyebrow-chip" aria-hidden="true">
            <span class="nf-icon">&#xf0ed;</span>
          </span>
          Fully offline installer
        </span>

        <h1 class="hero-title">
          Arch power with <span class="text-gradient">Material elegance</span>
        </h1>

        <p class="hero-lead">
          Boots into a barebones Hyprland session that just runs the installer.
          Answer a few questions and you get a finished Hyprland +
          DankMaterialShell desktop — no internet needed.
        </p>

        <div class="hero-actions">
          <slot name="actions" />
        </div>

        <ul class="hero-points">
          {
            points.map((p) => (
              <li>
                <span class="nf-icon" aria-hidden="true">
                  {String.fromCodePoint(parseInt(p.icon, 16))}
                </span>
                {p.label}
              </li>
            ))
          }
        </ul>

        <dl class="hero-stats">
          <div class="stat">
            <dt>Install time</dt>
            <dd>~1<span>min</span></dd>
          </div>
          <div class="stat">
            <dt>Installed size</dt>
            <dd>3.2<span>GB</span></dd>
          </div>
          <div class="stat">
            <dt>Languages</dt>
            <dd>{languages.length}</dd>
          </div>
        </dl>
      </div>

      <div class="hero-visual-wrap reveal" aria-hidden="true">
        <div class="hero-chip hero-chip--tl">
          <span class="nf-icon">&#xf0570;</span> Tiling by Hyprland
        </div>
        <div class="hero-visual">
          <div class="hero-shot hero-shot--dark">
            <img
              src="images/hero-dark.0cb56745.png"
              width="2560"
              height="1440"
              alt="Aelum fastfetch output in dark theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hero-shot hero-shot--light">
            <img
              src="images/hero-light.d35b98f8.png"
              width="2560"
              height="1440"
              alt="Aelum fastfetch output in light theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <div class="hero-chip hero-chip--br">
          <span class="nf-icon">&#xf0342;</span> DankMaterialShell
        </div>
      </div>
    </div>
  </div>
</section>
