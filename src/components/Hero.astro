---

---

<section class="section hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-title-wrap">
        <h1 class="section-title hero-title">
          Arch Power with Material <span class="text-gradient">Elegance</span> 
        </h1>
      </div>

      <div class="reveal-hero-visual" aria-hidden="true">
        <div class="hero-visual">
          <div class="hero-shot hero-shot--dark">
            <img
              src="images/hero-dark.03dafe93.png"
              width="2560"
              height="1440"
              alt="Aelum fastfetch output in dark theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hero-shot hero-shot--light">
            <img
              src="images/hero-light.b51fdabb.png"
              width="2560"
              height="1440"
              alt="Aelum fastfetch output in light theme"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="hero-below">
        <span class="eyebrow">
          Fully offline installer · No internet required to install
        </span>
        <p class="hero-lead">
          A Hyprland desktop with DankMaterialShell, plus Qt/GTK theming set up
          for you.
        </p>
        <div class="flex gap-4 hero-actions">
          <slot name="actions" />
        </div>

        <dl class="hero-stats">
          <div class="stat">
            <dt>Install time</dt>
            <dd>~1<span>min</span></dd>
          </div>
          <div class="stat">
            <dt>Installed size</dt>
            <dd>5<span>GB</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
