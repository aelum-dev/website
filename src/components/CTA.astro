---
import { installerRepo } from "../lib/site";

const glyph = (code: string) => String.fromCodePoint(parseInt(code, 16));
---

<section id="cta" class="section">
  <div class="container">
    <div class="cta-panel reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">{glyph("f0ed")}</span>
        </span>
        Get started
      </span>
      <h2>Ready to install Aelum?</h2>
      <p>
        Download the ISO, write it to a USB stick, and boot from it. The
        installer does the rest without internet, and a full install takes about
        a minute and a half.
      </p>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href="/download/">
          <span class="nf-icon" aria-hidden="true">{glyph("f0ed")}</span>
          Download Aelum
        </a>
        <a
          class="btn btn-ghost btn-lg"
          href={installerRepo}
          target="_blank"
          rel="noopener"
        >
          <span class="nf-icon" aria-hidden="true">{glyph("f09b")}</span>
          Source on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
