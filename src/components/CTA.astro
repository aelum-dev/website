---
import { dockerRepo } from "../lib/site";
---

<section id="cta" class="section">
  <div class="container">
    <div>
      <div class="card cta-card">
        <span class="eyebrow center-block">Build it yourself</span>
        <h2 class="cta-title">
          Build the ISO. <span class="text-gradient">Install in a minute.</span>
        </h2>
        <p class="cta-sub">
          Run one command — <code>make build</code> — and you've got a bootable ISO.
          Flash it, boot it, and let the installer do the rest.
        </p>
        <div class="flex justify-center cta-actions">
          <a
            class="btn btn-primary"
            href={dockerRepo}
            target="_blank"
            rel="noopener"
            ><span class="nf-icon" aria-hidden="true">&#xf296;</span> Build the ISO</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
