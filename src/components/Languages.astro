---
import { languages } from "../lib/site";

const half = Math.ceil(languages.length / 2);
const rows = [languages.slice(0, half), languages.slice(half)];
---

<section id="languages" class="section">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">
        <span class="eyebrow-chip" aria-hidden="true">
          <span class="nf-icon">&#xf0ac;</span>
        </span>
        {languages.length} languages
      </span>
      <h2 class="section-title">The installer in your language</h2>
      <p class="section-sub">
        The installer is available in {languages.length} languages. Choose one,
        and both the installer and your new system's locale follow it. The
        installed system also gets an Arch mirror list for your region (the
        worldwide list where Arch has no section for it).
      </p>
    </div>

    <div class="lang-marquee reveal">
      {
        rows.map((row, i) => (
          <div class={`lang-track${i === 1 ? " lang-track--reverse" : ""}`}>
            {row.map((lang) => (
              <span class="lang-chip">{lang}</span>
            ))}
            {row.map((lang) => (
              <span class="lang-chip" aria-hidden="true">
                {lang}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
