---
import { languages } from '../lib/site';
---

<section class="section section-no-top">
  <div class="container">
    <div class="reveal center-block lang-head">
      <p>The installer speaks {languages.length} languages</p>
    </div>
    <div class="flex flex-wrap justify-center lang-chips">
      {languages.map((lang) => (
        <span class="card lang-chip">{lang}</span>
      ))}
    </div>
  </div>
</section>
