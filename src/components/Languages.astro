---
import { languages } from "../lib/site";
---

<section id="languages" class="section">
  <div class="container">
    <div class="center-block lang-head">
      <p>The installer speaks {languages.length} languages</p>
    </div>
    <div class="flex flex-wrap justify-center lang-chips">
      {languages.map((lang) => <span class="card lang-chip">{lang}</span>)}
    </div>
  </div>
</section>
